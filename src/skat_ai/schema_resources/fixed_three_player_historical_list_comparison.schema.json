{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/fixed_three_player_historical_list_comparison.schema.json",
  "title": "skat-ai fixed-three-player historical-list comparison version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_version",
    "basis",
    "reference_list_id",
    "list_count",
    "player_ids",
    "source_lists",
    "comparisons"
  ],
  "properties": {
    "comparison_version": {"const": 1},
    "basis": {"const": "independent_completed_fixed_three_player_historical_lists"},
    "reference_list_id": {"$ref": "#/$defs/stable_identifier"},
    "list_count": {"type": "integer", "minimum": 2},
    "player_ids": {"$ref": "#/$defs/three_player_ids"},
    "source_lists": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/source_summary"}
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pairwise_comparison"}
    }
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    },
    "nullable_label": {
      "oneOf": [
        {"$ref": "#/$defs/stable_identifier"},
        {"type": "null"}
      ]
    },
    "table_place": {"enum": ["place_1", "place_2", "place_3"]},
    "ranking_status": {"enum": ["final", "lot_required"]},
    "rank_comparison_status": {
      "enum": [
        "available",
        "reference_lot_required",
        "comparison_lot_required",
        "both_lot_required"
      ]
    },
    "player_id_array": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_identifier"}
    },
    "three_player_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_identifier"}
    },
    "nullable_lot_order": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_identifier"}
        }
      ]
    },
    "compact_standing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "player_id",
        "player_label",
        "table_place",
        "total_performance_points",
        "own_games_won",
        "own_games_lost"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "player_id": {"$ref": "#/$defs/stable_identifier"},
        "player_label": {"$ref": "#/$defs/nullable_label"},
        "table_place": {"$ref": "#/$defs/table_place"},
        "total_performance_points": {"type": "integer"},
        "own_games_won": {"type": "integer", "minimum": 0, "maximum": 36},
        "own_games_lost": {"type": "integer", "minimum": 0, "maximum": 36}
      }
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_version",
        "basis",
        "list_id",
        "source_list_schema_version",
        "entry_count",
        "round_count",
        "played_game_count",
        "passed_deal_count",
        "declarer_win_count",
        "declarer_loss_count",
        "ranking_status",
        "tied_player_ids",
        "lot_required_player_ids",
        "applied_lot_order",
        "final_standings"
      ],
      "properties": {
        "comparison_version": {"const": 1},
        "basis": {"const": "independent_completed_fixed_three_player_historical_lists"},
        "list_id": {"$ref": "#/$defs/stable_identifier"},
        "source_list_schema_version": {"const": 1},
        "entry_count": {"const": 36},
        "round_count": {"const": 12},
        "played_game_count": {"type": "integer", "minimum": 0, "maximum": 36},
        "passed_deal_count": {"type": "integer", "minimum": 0, "maximum": 36},
        "declarer_win_count": {"type": "integer", "minimum": 0, "maximum": 36},
        "declarer_loss_count": {"type": "integer", "minimum": 0, "maximum": 36},
        "ranking_status": {"$ref": "#/$defs/ranking_status"},
        "tied_player_ids": {"$ref": "#/$defs/player_id_array"},
        "lot_required_player_ids": {"$ref": "#/$defs/player_id_array"},
        "applied_lot_order": {"$ref": "#/$defs/nullable_lot_order"},
        "final_standings": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/compact_standing"}
        }
      }
    },
    "totals_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_entry_count",
        "played_game_count",
        "passed_deal_count",
        "declarer_game_count",
        "defender_game_count",
        "own_games_won",
        "own_games_lost",
        "defender_games_won",
        "defender_games_lost",
        "other_players_lost_games",
        "player_game_points",
        "own_game_bonus_points",
        "opponent_loss_bonus_points",
        "total_performance_points"
      ],
      "properties": {
        "list_entry_count": {"type": "integer"},
        "played_game_count": {"type": "integer"},
        "passed_deal_count": {"type": "integer"},
        "declarer_game_count": {"type": "integer"},
        "defender_game_count": {"type": "integer"},
        "own_games_won": {"type": "integer"},
        "own_games_lost": {"type": "integer"},
        "defender_games_won": {"type": "integer"},
        "defender_games_lost": {"type": "integer"},
        "other_players_lost_games": {"type": "integer"},
        "player_game_points": {"type": "integer"},
        "own_game_bonus_points": {"type": "integer"},
        "opponent_loss_bonus_points": {"type": "integer"},
        "total_performance_points": {"type": "integer"}
      }
    },
    "nullable_rank": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 3},
        {"type": "null"}
      ]
    },
    "nullable_integer": {
      "oneOf": [{"type": "integer"}, {"type": "null"}]
    },
    "player_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_version",
        "player_id",
        "player_label",
        "reference_table_place",
        "comparison_table_place",
        "reference_totals",
        "comparison_totals",
        "deltas",
        "rank_comparison_status",
        "reference_rank",
        "comparison_rank",
        "rank_position_change"
      ],
      "properties": {
        "comparison_version": {"const": 1},
        "player_id": {"$ref": "#/$defs/stable_identifier"},
        "player_label": {"$ref": "#/$defs/nullable_label"},
        "reference_table_place": {"$ref": "#/$defs/table_place"},
        "comparison_table_place": {"$ref": "#/$defs/table_place"},
        "reference_totals": {
          "$ref": "https://example.local/skat-ai/fixed_three_player_historical_list_aggregation.schema.json#/$defs/player_totals"
        },
        "comparison_totals": {
          "$ref": "https://example.local/skat-ai/fixed_three_player_historical_list_aggregation.schema.json#/$defs/player_totals"
        },
        "deltas": {"$ref": "#/$defs/totals_delta"},
        "rank_comparison_status": {"$ref": "#/$defs/rank_comparison_status"},
        "reference_rank": {"$ref": "#/$defs/nullable_rank"},
        "comparison_rank": {"$ref": "#/$defs/nullable_rank"},
        "rank_position_change": {"$ref": "#/$defs/nullable_integer"}
      }
    },
    "pairwise_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_version",
        "reference_list_id",
        "comparison_list_id",
        "reference_summary",
        "comparison_summary",
        "played_game_count_delta",
        "passed_deal_count_delta",
        "declarer_win_count_delta",
        "declarer_loss_count_delta",
        "final_rank_comparison_available",
        "player_comparisons"
      ],
      "properties": {
        "comparison_version": {"const": 1},
        "reference_list_id": {"$ref": "#/$defs/stable_identifier"},
        "comparison_list_id": {"$ref": "#/$defs/stable_identifier"},
        "reference_summary": {"$ref": "#/$defs/source_summary"},
        "comparison_summary": {"$ref": "#/$defs/source_summary"},
        "played_game_count_delta": {"type": "integer"},
        "passed_deal_count_delta": {"type": "integer"},
        "declarer_win_count_delta": {"type": "integer"},
        "declarer_loss_count_delta": {"type": "integer"},
        "final_rank_comparison_available": {"type": "boolean"},
        "player_comparisons": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/player_comparison"}
        }
      }
    }
  }
}
