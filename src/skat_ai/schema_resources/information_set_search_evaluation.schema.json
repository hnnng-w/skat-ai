{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/information_set_search_evaluation.schema.json",
  "title": "skat-ai information-set search evaluation version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_method",
    "source_dataset",
    "settings",
    "selection",
    "record_count",
    "zero_decision_record_count",
    "available_decision_count",
    "decision_count",
    "status_counts",
    "coverage_counts",
    "same_selected_world_sequence_count",
    "selected_world_count_total",
    "sampled_world_count_total",
    "comparison_available_count",
    "comparison_unavailable_count",
    "information_set_recommendation_count",
    "pimc_recommendation_count",
    "immediate_recommendation_count",
    "information_set_pimc_agreement",
    "information_set_immediate_agreement",
    "pimc_immediate_agreement",
    "information_set_actual_agreement",
    "pimc_actual_agreement",
    "immediate_actual_agreement",
    "breakdowns",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_method": {
      "const": "information_set_search_vs_same_selection_pimc_and_immediate_v1"
    },
    "source_dataset": {"$ref": "#/$defs/source_dataset"},
    "settings": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/settings"
    },
    "selection": {"$ref": "#/$defs/selection"},
    "record_count": {"$ref": "#/$defs/count"},
    "zero_decision_record_count": {"$ref": "#/$defs/count"},
    "available_decision_count": {"$ref": "#/$defs/count"},
    "decision_count": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/decision_count"
    },
    "status_counts": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/status_counts"
    },
    "coverage_counts": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/coverage_counts"
    },
    "same_selected_world_sequence_count": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/same_selected_world_sequence_count"
    },
    "selected_world_count_total": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/selected_world_count_total"
    },
    "sampled_world_count_total": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/sampled_world_count_total"
    },
    "comparison_available_count": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/comparison_available_count"
    },
    "comparison_unavailable_count": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/comparison_unavailable_count"
    },
    "information_set_recommendation_count": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/information_set_recommendation_count"
    },
    "pimc_recommendation_count": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/pimc_recommendation_count"
    },
    "immediate_recommendation_count": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/immediate_recommendation_count"
    },
    "information_set_pimc_agreement": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/information_set_pimc_agreement"
    },
    "information_set_immediate_agreement": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/information_set_immediate_agreement"
    },
    "pimc_immediate_agreement": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/pimc_immediate_agreement"
    },
    "information_set_actual_agreement": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/information_set_actual_agreement"
    },
    "pimc_actual_agreement": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/pimc_actual_agreement"
    },
    "immediate_actual_agreement": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics/properties/immediate_actual_agreement"
    },
    "breakdowns": {"$ref": "#/$defs/evaluation_breakdowns"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluation_record"},
      "minItems": 1
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "metrics": {
      "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/metrics"
    },
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    },
    "partition": {"enum": ["train", "validation", "test"]},
    "partition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "mode"],
      "properties": {
        "policy_version": {"const": 1},
        "mode": {"enum": ["known_opponent", "unseen_player"]}
      }
    },
    "source_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "training_dataset_schema_version",
        "feature_generation_version",
        "target"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/stable_identifier"},
        "dataset_version": {"$ref": "#/$defs/stable_identifier"},
        "training_dataset_schema_version": {"const": 1},
        "feature_generation_version": {"const": 1},
        "target": {"const": "actual_card_played"},
        "partition_policy": {"$ref": "#/$defs/partition_policy"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partitions",
        "max_decisions",
        "record_count",
        "available_decision_count",
        "evaluated_decision_count",
        "decision_cap_reached"
      ],
      "properties": {
        "partitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/partition"},
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "max_decisions": {"type": ["integer", "null"], "minimum": 1},
        "record_count": {"$ref": "#/$defs/count"},
        "available_decision_count": {"$ref": "#/$defs/count"},
        "evaluated_decision_count": {"$ref": "#/$defs/count"},
        "decision_cap_reached": {"type": "boolean"}
      }
    },
    "evaluation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "partition",
        "source_game_id",
        "source_decision_count",
        "evaluated_decision_count",
        "decisions"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/stable_identifier"},
        "partition": {"$ref": "#/$defs/partition"},
        "source_game_id": {"$ref": "#/$defs/stable_identifier"},
        "source_decision_count": {"type": "integer", "minimum": 0, "maximum": 30},
        "evaluated_decision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/decision"
          },
          "maxItems": 30
        }
      }
    },
    "evaluation_breakdown_row": {
      "type": "object",
      "required": ["metrics"],
      "properties": {"metrics": {"$ref": "#/$defs/metrics"}}
    },
    "partition_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["partition"],
          "properties": {"partition": {"$ref": "#/$defs/partition"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "contract_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["contract"],
          "properties": {
            "contract": {
              "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/game_type"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "role_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["role"],
          "properties": {"role": {"enum": ["declarer", "defenders"]}}
        }
      ],
      "unevaluatedProperties": false
    },
    "seat_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["seat"],
          "properties": {"seat": {"enum": ["forehand", "middlehand", "rearhand"]}}
        }
      ],
      "unevaluatedProperties": false
    },
    "phase_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["phase"],
          "properties": {"phase": {"enum": ["lead", "response"]}}
        }
      ],
      "unevaluatedProperties": false
    },
    "status_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/information_set_status"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "coverage_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["coverage"],
          "properties": {
            "coverage": {
              "$ref": "https://example.local/skat-ai/historical_information_set_search_review.schema.json#/$defs/world_coverage"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "recommendation_agreement_breakdown": {
      "allOf": [
        {"$ref": "#/$defs/evaluation_breakdown_row"},
        {
          "type": "object",
          "required": ["agreement"],
          "properties": {"agreement": {"enum": ["same", "different", "not_available"]}}
        }
      ],
      "unevaluatedProperties": false
    },
    "evaluation_breakdowns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_partition",
        "by_contract",
        "by_role",
        "by_seat",
        "by_phase",
        "by_status",
        "by_coverage",
        "by_recommendation_agreement"
      ],
      "properties": {
        "by_partition": {
          "type": "array",
          "items": {"$ref": "#/$defs/partition_breakdown"},
          "maxItems": 3
        },
        "by_contract": {
          "type": "array",
          "items": {"$ref": "#/$defs/contract_breakdown"},
          "maxItems": 6
        },
        "by_role": {
          "type": "array",
          "items": {"$ref": "#/$defs/role_breakdown"},
          "maxItems": 2
        },
        "by_seat": {
          "type": "array",
          "items": {"$ref": "#/$defs/seat_breakdown"},
          "maxItems": 3
        },
        "by_phase": {
          "type": "array",
          "items": {"$ref": "#/$defs/phase_breakdown"},
          "maxItems": 2
        },
        "by_status": {
          "type": "array",
          "items": {"$ref": "#/$defs/status_breakdown"},
          "maxItems": 5
        },
        "by_coverage": {
          "type": "array",
          "items": {"$ref": "#/$defs/coverage_breakdown"},
          "maxItems": 4
        },
        "by_recommendation_agreement": {
          "type": "array",
          "items": {"$ref": "#/$defs/recommendation_agreement_breakdown"},
          "maxItems": 3
        }
      }
    }
  }
}
