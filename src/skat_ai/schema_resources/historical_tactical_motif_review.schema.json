{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/historical_tactical_motif_review.schema.json",
  "title": "skat-ai public historical tactical motif review version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "historical_tactical_motif_review_version",
    "review_method",
    "information_policy",
    "source_game_id",
    "observation_count",
    "complete_observation_count",
    "partial_observation_count",
    "motif_occurrence_count",
    "observations",
    "motif_counts",
    "family_counts",
    "player_summaries",
    "role_summaries",
    "phase_summaries",
    "contract_summaries",
    "limitations"
  ],
  "properties": {
    "historical_tactical_motif_review_version": {"const": 1},
    "review_method": {"const": "historical_tactical_motif_review_v1"},
    "information_policy": {
      "const": "decision_time_facts_then_actual_play_then_optional_trick_outcome"
    },
    "source_game_id": {"$ref": "#/$defs/stable_identifier"},
    "observation_count": {"$ref": "#/$defs/decision_count"},
    "complete_observation_count": {"$ref": "#/$defs/decision_count"},
    "partial_observation_count": {"$ref": "#/$defs/decision_count"},
    "motif_occurrence_count": {"$ref": "#/$defs/motif_occurrence_count"},
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision_observation"},
      "maxItems": 30
    },
    "motif_counts": {"$ref": "#/$defs/motif_counts"},
    "family_counts": {"$ref": "#/$defs/family_counts"},
    "player_summaries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/scope_summary"},
          {"properties": {"scope": {"const": "player"}}}
        ]
      }
    },
    "role_summaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/scope_summary"},
            {
              "properties": {
                "scope": {"const": "role"},
                "scope_value": {"const": "declarer"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/scope_summary"},
            {
              "properties": {
                "scope": {"const": "role"},
                "scope_value": {"const": "defenders"}
              }
            }
          ]
        }
      ],
      "items": false
    },
    "phase_summaries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/scope_summary"},
            {
              "properties": {
                "scope": {"const": "phase"},
                "scope_value": {"const": "opening"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/scope_summary"},
            {
              "properties": {
                "scope": {"const": "phase"},
                "scope_value": {"const": "middle"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/scope_summary"},
            {
              "properties": {
                "scope": {"const": "phase"},
                "scope_value": {"const": "endgame"}
              }
            }
          ]
        }
      ],
      "items": false
    },
    "contract_summaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/scope_summary"},
          {
            "properties": {
              "scope": {"const": "contract"},
              "scope_value": {"$ref": "#/$defs/game_type"}
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"const": "single_recorded_game_only"},
        {"const": "structural_observation_not_quality_assessment"},
        {"const": "actual_card_not_ground_truth"},
        {"const": "no_intent_or_signaling_claim"},
        {"const": "no_communication_success_claim"},
        {"const": "no_causal_outcome_claim"},
        {"const": "no_hidden_ownership_inference"},
        {"const": "no_search_or_optimality_claim"},
        {"const": "no_commentary_interpretation"},
        {"const": "no_cross_game_player_trait"}
      ],
      "items": false
    }
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    },
    "decision_count": {"type": "integer", "minimum": 0, "maximum": 30},
    "motif_occurrence_count": {"type": "integer", "minimum": 0, "maximum": 480},
    "decision_index": {"type": "integer", "minimum": 1, "maximum": 30},
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "game_type": {
      "enum": ["clubs", "spades", "hearts", "diamonds", "grand", "null"]
    },
    "side": {"enum": ["declarer", "defenders"]},
    "effective_category": {"enum": ["TRUMP", "C", "S", "H", "D"]},
    "nullable_effective_category": {
      "oneOf": [{"$ref": "#/$defs/effective_category"}, {"type": "null"}]
    },
    "nullable_identifier": {
      "oneOf": [{"$ref": "#/$defs/stable_identifier"}, {"type": "null"}]
    },
    "nullable_side": {
      "oneOf": [{"$ref": "#/$defs/side"}, {"type": "null"}]
    },
    "motif_type": {
      "enum": [
        "trump_lead",
        "non_trump_lead",
        "new_effective_category_lead",
        "repeat_effective_category_lead",
        "void_trump_play",
        "void_non_trump_discard",
        "available_trump_not_used",
        "opposing_side_overtake",
        "current_trick_win_available_not_taken",
        "lowest_cost_current_winner",
        "partner_effective_category_return",
        "partner_overtake",
        "partner_safe_point_load",
        "point_card_captured_by_partner",
        "effective_category_exhausted",
        "point_card_lost_to_opposing_side"
      ]
    },
    "motif_family": {
      "enum": [
        "lead_structure",
        "void_response",
        "trick_control",
        "defender_partnership",
        "hand_shape",
        "trick_outcome"
      ]
    },
    "motif_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motif_type", "count"],
      "properties": {
        "motif_type": {"$ref": "#/$defs/motif_type"},
        "count": {"$ref": "#/$defs/motif_occurrence_count"}
      }
    },
    "family_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motif_family", "count"],
      "properties": {
        "motif_family": {"$ref": "#/$defs/motif_family"},
        "count": {"$ref": "#/$defs/motif_occurrence_count"}
      }
    },
    "motif_counts": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "trump_lead"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "non_trump_lead"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "new_effective_category_lead"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "repeat_effective_category_lead"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "void_trump_play"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "void_non_trump_discard"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "available_trump_not_used"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "opposing_side_overtake"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "current_trick_win_available_not_taken"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "lowest_cost_current_winner"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "partner_effective_category_return"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "partner_overtake"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "partner_safe_point_load"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "point_card_captured_by_partner"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "effective_category_exhausted"}}}]},
        {"allOf": [{"$ref": "#/$defs/motif_count"}, {"properties": {"motif_type": {"const": "point_card_lost_to_opposing_side"}}}]}
      ],
      "items": false
    },
    "family_counts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/family_count"}, {"properties": {"motif_family": {"const": "lead_structure"}}}]},
        {"allOf": [{"$ref": "#/$defs/family_count"}, {"properties": {"motif_family": {"const": "void_response"}}}]},
        {"allOf": [{"$ref": "#/$defs/family_count"}, {"properties": {"motif_family": {"const": "trick_control"}}}]},
        {"allOf": [{"$ref": "#/$defs/family_count"}, {"properties": {"motif_family": {"const": "defender_partnership"}}}]},
        {"allOf": [{"$ref": "#/$defs/family_count"}, {"properties": {"motif_family": {"const": "hand_shape"}}}]},
        {"allOf": [{"$ref": "#/$defs/family_count"}, {"properties": {"motif_family": {"const": "trick_outcome"}}}]}
      ],
      "items": false
    },
    "decision_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tactical_decision_facts_version",
        "source_game_id",
        "decision_index",
        "trick_number",
        "play_index",
        "acting_player_id",
        "acting_seat",
        "acting_side",
        "partner_player_id",
        "game_type",
        "information_cutoff",
        "required_effective_category",
        "can_follow_required_effective_category",
        "legal_card_count",
        "legal_trump_count",
        "legal_current_winning_card_count",
        "legal_partner_safe_card_count",
        "pre_play_current_winner_player_id",
        "pre_play_current_winner_side",
        "partner_currently_winning_before",
        "previous_lead_effective_categories",
        "partner_last_lead_effective_category"
      ],
      "properties": {
        "tactical_decision_facts_version": {"const": 1},
        "source_game_id": {"$ref": "#/$defs/stable_identifier"},
        "decision_index": {"$ref": "#/$defs/decision_index"},
        "trick_number": {"type": "integer", "minimum": 1, "maximum": 10},
        "play_index": {"type": "integer", "minimum": 1, "maximum": 3},
        "acting_player_id": {"$ref": "#/$defs/stable_identifier"},
        "acting_seat": {"enum": ["forehand", "middlehand", "rearhand"]},
        "acting_side": {"$ref": "#/$defs/side"},
        "partner_player_id": {"$ref": "#/$defs/nullable_identifier"},
        "game_type": {"$ref": "#/$defs/game_type"},
        "information_cutoff": {"const": "before_actual_play"},
        "required_effective_category": {"$ref": "#/$defs/nullable_effective_category"},
        "can_follow_required_effective_category": {"type": ["boolean", "null"]},
        "legal_card_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "legal_trump_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "legal_current_winning_card_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "legal_partner_safe_card_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "pre_play_current_winner_player_id": {"$ref": "#/$defs/nullable_identifier"},
        "pre_play_current_winner_side": {"$ref": "#/$defs/nullable_side"},
        "partner_currently_winning_before": {"type": "boolean"},
        "previous_lead_effective_categories": {
          "type": "array",
          "items": {"$ref": "#/$defs/effective_category"},
          "maxItems": 9
        },
        "partner_last_lead_effective_category": {"$ref": "#/$defs/nullable_effective_category"}
      }
    },
    "motif_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tactical_motif_occurrence_version",
        "motif_type",
        "motif_family",
        "evidence_time"
      ],
      "properties": {
        "tactical_motif_occurrence_version": {"const": 1},
        "motif_type": {"$ref": "#/$defs/motif_type"},
        "motif_family": {"$ref": "#/$defs/motif_family"},
        "evidence_time": {"enum": ["after_actual_play", "after_trick_completion"]}
      },
      "allOf": [
        {
          "if": {"properties": {"motif_type": {"enum": ["trump_lead", "non_trump_lead", "new_effective_category_lead", "repeat_effective_category_lead"]}}},
          "then": {"properties": {"motif_family": {"const": "lead_structure"}, "evidence_time": {"const": "after_actual_play"}}}
        },
        {
          "if": {"properties": {"motif_type": {"enum": ["void_trump_play", "void_non_trump_discard", "available_trump_not_used"]}}},
          "then": {"properties": {"motif_family": {"const": "void_response"}, "evidence_time": {"const": "after_actual_play"}}}
        },
        {
          "if": {"properties": {"motif_type": {"enum": ["opposing_side_overtake", "current_trick_win_available_not_taken", "lowest_cost_current_winner"]}}},
          "then": {"properties": {"motif_family": {"const": "trick_control"}, "evidence_time": {"const": "after_actual_play"}}}
        },
        {
          "if": {"properties": {"motif_type": {"enum": ["partner_effective_category_return", "partner_overtake", "partner_safe_point_load"]}}},
          "then": {"properties": {"motif_family": {"const": "defender_partnership"}, "evidence_time": {"const": "after_actual_play"}}}
        },
        {
          "if": {"properties": {"motif_type": {"const": "point_card_captured_by_partner"}}},
          "then": {"properties": {"motif_family": {"const": "defender_partnership"}, "evidence_time": {"const": "after_trick_completion"}}}
        },
        {
          "if": {"properties": {"motif_type": {"const": "effective_category_exhausted"}}},
          "then": {"properties": {"motif_family": {"const": "hand_shape"}, "evidence_time": {"const": "after_actual_play"}}}
        },
        {
          "if": {"properties": {"motif_type": {"const": "point_card_lost_to_opposing_side"}}},
          "then": {"properties": {"motif_family": {"const": "trick_outcome"}, "evidence_time": {"const": "after_trick_completion"}}}
        }
      ]
    },
    "decision_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tactical_decision_observation_version",
        "decision_time_facts",
        "actual_card",
        "actual_effective_category",
        "actual_is_trump",
        "actual_card_points",
        "post_play_current_winner_player_id",
        "post_play_current_winner_side",
        "actual_is_current_winner",
        "actual_keeps_partner_winning",
        "actual_overtakes_partner",
        "actual_is_lowest_cost_current_winner",
        "remaining_actual_effective_category_count",
        "completed_trick_winner_player_id",
        "completed_trick_winner_side",
        "completed_trick_points",
        "observation_status",
        "motifs"
      ],
      "properties": {
        "tactical_decision_observation_version": {"const": 1},
        "decision_time_facts": {"$ref": "#/$defs/decision_facts"},
        "actual_card": {"$ref": "#/$defs/card"},
        "actual_effective_category": {"$ref": "#/$defs/effective_category"},
        "actual_is_trump": {"type": "boolean"},
        "actual_card_points": {"type": "integer", "minimum": 0, "maximum": 11},
        "post_play_current_winner_player_id": {"$ref": "#/$defs/stable_identifier"},
        "post_play_current_winner_side": {"$ref": "#/$defs/side"},
        "actual_is_current_winner": {"type": "boolean"},
        "actual_keeps_partner_winning": {"type": "boolean"},
        "actual_overtakes_partner": {"type": "boolean"},
        "actual_is_lowest_cost_current_winner": {"type": "boolean"},
        "remaining_actual_effective_category_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "completed_trick_winner_player_id": {"$ref": "#/$defs/nullable_identifier"},
        "completed_trick_winner_side": {"$ref": "#/$defs/nullable_side"},
        "completed_trick_points": {"type": ["integer", "null"], "minimum": 0, "maximum": 33},
        "observation_status": {"enum": ["complete", "partial"]},
        "motifs": {
          "type": "array",
          "items": {"$ref": "#/$defs/motif_occurrence"},
          "uniqueItems": true,
          "maxItems": 16
        }
      },
      "allOf": [
        {
          "if": {"properties": {"observation_status": {"const": "complete"}}},
          "then": {
            "properties": {
              "completed_trick_winner_player_id": {"$ref": "#/$defs/stable_identifier"},
              "completed_trick_winner_side": {"$ref": "#/$defs/side"},
              "completed_trick_points": {"type": "integer", "minimum": 0, "maximum": 33}
            }
          }
        },
        {
          "if": {"properties": {"observation_status": {"const": "partial"}}},
          "then": {
            "properties": {
              "completed_trick_winner_player_id": {"const": null},
              "completed_trick_winner_side": {"const": null},
              "completed_trick_points": {"const": null},
              "motifs": {
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/motif_occurrence"},
                    {"properties": {"evidence_time": {"const": "after_actual_play"}}}
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "scope_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scope_value",
        "observation_count",
        "complete_observation_count",
        "partial_observation_count",
        "motif_occurrence_count",
        "decision_indices",
        "motif_counts",
        "family_counts"
      ],
      "properties": {
        "scope": {"enum": ["player", "role", "phase", "contract"]},
        "scope_value": {"$ref": "#/$defs/stable_identifier"},
        "observation_count": {"$ref": "#/$defs/decision_count"},
        "complete_observation_count": {"$ref": "#/$defs/decision_count"},
        "partial_observation_count": {"$ref": "#/$defs/decision_count"},
        "motif_occurrence_count": {"$ref": "#/$defs/motif_occurrence_count"},
        "decision_indices": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision_index"},
          "uniqueItems": true,
          "maxItems": 30
        },
        "motif_counts": {"$ref": "#/$defs/motif_counts"},
        "family_counts": {"$ref": "#/$defs/family_counts"}
      }
    }
  }
}
