{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/bounded_search_evaluation.schema.json",
  "title": "skat-ai bounded search evaluation summary version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_method",
    "source_dataset",
    "settings",
    "selection",
    "record_count",
    "zero_decision_record_count",
    "available_decision_count",
    "decision_counts",
    "status_counts",
    "coverage",
    "search_vs_immediate_agreement",
    "quality_gate",
    "actual_card_agreement",
    "search_aggregate_quality",
    "performance",
    "breakdowns",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_method": {"const": "bounded_search_vs_immediate_v1"},
    "source_dataset": {"$ref": "#/$defs/source_dataset"},
    "settings": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/settings"
    },
    "selection": {"$ref": "#/$defs/selection"},
    "record_count": {"$ref": "#/$defs/count"},
    "zero_decision_record_count": {"$ref": "#/$defs/count"},
    "available_decision_count": {"$ref": "#/$defs/count"},
    "decision_counts": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/decision_counts"
    },
    "status_counts": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/status_counts"
    },
    "coverage": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/coverage"
    },
    "search_vs_immediate_agreement": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/search_vs_immediate_agreement"
    },
    "quality_gate": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/quality_gate"
    },
    "actual_card_agreement": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/actual_card_agreement"
    },
    "search_aggregate_quality": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/search_aggregate_quality"
    },
    "performance": {
      "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/performance"
    },
    "breakdowns": {"$ref": "#/$defs/evaluation_breakdowns"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluation_record"},
      "minItems": 1
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    },
    "partition": {
      "type": "string",
      "enum": ["train", "validation", "test"]
    },
    "partition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "mode"],
      "properties": {
        "policy_version": {"const": 1},
        "mode": {"enum": ["known_opponent", "unseen_player"]}
      }
    },
    "source_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "training_dataset_schema_version",
        "feature_generation_version",
        "target"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/stable_identifier"},
        "dataset_version": {"$ref": "#/$defs/stable_identifier"},
        "training_dataset_schema_version": {"const": 1},
        "feature_generation_version": {"const": 1},
        "target": {"const": "actual_card_played"},
        "partition_policy": {"$ref": "#/$defs/partition_policy"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partitions",
        "max_decisions",
        "record_count",
        "available_decision_count",
        "evaluated_decision_count",
        "decision_cap_reached"
      ],
      "properties": {
        "partitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/partition"},
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "max_decisions": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "record_count": {"$ref": "#/$defs/count"},
        "available_decision_count": {"$ref": "#/$defs/count"},
        "evaluated_decision_count": {"$ref": "#/$defs/count"},
        "decision_cap_reached": {"type": "boolean"}
      }
    },
    "evaluation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "partition",
        "source_game_id",
        "source_decision_count",
        "evaluated_decision_count",
        "decisions"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/stable_identifier"},
        "partition": {"$ref": "#/$defs/partition"},
        "source_game_id": {"$ref": "#/$defs/stable_identifier"},
        "source_decision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "evaluated_decision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/decision"
          },
          "maxItems": 30
        }
      }
    },
    "evaluation_breakdowns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_partition",
        "by_game_type",
        "by_local_side",
        "by_root_seat",
        "by_remaining_tricks",
        "by_status",
        "by_coverage"
      ],
      "properties": {
        "by_partition": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/partition_breakdown"
          },
          "maxItems": 3
        },
        "by_game_type": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/game_type_breakdown"
          },
          "maxItems": 6
        },
        "by_local_side": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/local_side_breakdown"
          },
          "maxItems": 2
        },
        "by_root_seat": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/root_seat_breakdown"
          },
          "maxItems": 3
        },
        "by_remaining_tricks": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/remaining_tricks_breakdown"
          },
          "maxItems": 10
        },
        "by_status": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/status_breakdown"
          },
          "maxItems": 4
        },
        "by_coverage": {
          "type": "array",
          "items": {
            "$ref": "https://example.local/skat-ai/historical_search_review.schema.json#/$defs/coverage_breakdown"
          },
          "maxItems": 4
        }
      }
    }
  }
}
