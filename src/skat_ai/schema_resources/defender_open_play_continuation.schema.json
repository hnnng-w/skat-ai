{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/defender_open_play_continuation.schema.json",
  "title": "skat-ai defender open play continuation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "exposing_defender",
    "declarer_response",
    "public_exposing_defender_cards"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "defender_open_play"},
    "exposing_defender": {
      "type": "string",
      "enum": ["me", "left", "right"]
    },
    "declarer_response": {"const": "request_continued_play"},
    "public_exposing_defender_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
      }
    }
  }
}
