{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/historical_declarer_card_exposure_output.schema.json",
  "title": "skat-ai historical accepted declarer-card-exposure output version 1",
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!me$|left$|right$)(?:[\\s\\S]*\\S)?$"
    },
    "game_end_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "rule_sections",
        "declarer_player_id",
        "exposure_form",
        "shown_to_defender_player_id",
        "exposed_cards",
        "exposed_card_count",
        "card_reconciliation",
        "unanimous_defender_acceptance",
        "accepting_defender_player_ids",
        "acceptance_forms",
        "claimed_play_level",
        "decision_state_before_shortening",
        "adjudicated_winner",
        "winner_basis",
        "continued_play_required",
        "remaining_points_assigned",
        "settlement_level_policy",
        "event_after_play_count",
        "event_after_completed_trick_count",
        "event_during_incomplete_trick"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "declarer_card_exposure"},
        "rule_sections": {
          "type": "array",
          "prefixItems": [{"const": "4.4.4"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "declarer_player_id": {"$ref": "#/$defs/stable_identifier"},
        "exposure_form": {"enum": ["laid_open", "shown_to_defender"]},
        "shown_to_defender_player_id": {
          "oneOf": [
            {"$ref": "#/$defs/stable_identifier"},
            {"type": "null"}
          ]
        },
        "exposed_cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"}
        },
        "exposed_card_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "card_reconciliation": {"const": "confirmed"},
        "unanimous_defender_acceptance": {"const": true},
        "accepting_defender_player_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stable_identifier"},
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "acceptance_forms": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "propertyNames": {"$ref": "#/$defs/stable_identifier"},
          "additionalProperties": {
            "enum": ["explicit", "unambiguous_conduct"]
          }
        },
        "claimed_play_level": {"enum": ["simple", "schneider", "schwarz"]},
        "decision_state_before_shortening": {
          "enum": ["undecided", "declarer_already_won", "defenders_already_won"]
        },
        "adjudicated_winner": {"enum": ["declarer", "defenders"]},
        "winner_basis": {
          "enum": [
            "accepted_declarer_card_exposure",
            "preexisting_game_decision",
            "uncovered_overbid_requirement"
          ]
        },
        "continued_play_required": {"const": false},
        "remaining_points_assigned": {"const": false},
        "settlement_level_policy": {
          "enum": [
            "declared_and_unanimously_accepted_claimed_levels",
            "secured_observed_levels_only"
          ]
        },
        "event_after_play_count": {"type": "integer", "minimum": 0, "maximum": 29},
        "event_after_completed_trick_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "event_during_incomplete_trick": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"exposure_form": {"const": "laid_open"}},
            "required": ["exposure_form"]
          },
          "then": {
            "properties": {"shown_to_defender_player_id": {"type": "null"}}
          },
          "else": {
            "properties": {
              "shown_to_defender_player_id": {
                "$ref": "#/$defs/stable_identifier"
              }
            }
          }
        }
      ]
    }
  }
}
