{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/bounded_search_post_game_review.schema.json",
  "title": "skat-ai bounded search post-game review summary version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_method",
    "game_type",
    "search_actual_card_comparison",
    "search_vs_immediate_comparison"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_method": {"const": "bounded_search_with_immediate_baseline"},
    "game_type": {"enum": ["clubs", "spades", "hearts", "diamonds", "grand", "null"]},
    "search_actual_card_comparison": {
      "$ref": "#/$defs/search_actual_card_comparison"
    },
    "search_vs_immediate_comparison": {
      "$ref": "#/$defs/search_vs_immediate_comparison"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"game_type": {"const": "null"}},
        "required": ["game_type"]
      },
      "then": {
        "properties": {
          "search_actual_card_comparison": {
            "properties": {
              "actual_card_metrics": {"$ref": "#/$defs/nullable_null_search_aggregate_metrics"},
              "recommended_card_metrics": {"$ref": "#/$defs/nullable_null_search_aggregate_metrics"},
              "mean_local_side_card_point_margin_gap": {"type": "null"}
            }
          },
          "search_vs_immediate_comparison": {
            "properties": {
              "search_mean_card_point_margin_advantage": {"type": "null"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "search_actual_card_comparison": {
            "properties": {
              "actual_card_metrics": {"$ref": "#/$defs/nullable_non_null_search_aggregate_metrics"},
              "recommended_card_metrics": {"$ref": "#/$defs/nullable_non_null_search_aggregate_metrics"}
            },
            "if": {
              "properties": {"is_available": {"const": true}},
              "required": ["is_available"]
            },
            "then": {
              "properties": {
                "mean_local_side_card_point_margin_gap": {"type": "number"}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "nullable_card": {
      "oneOf": [
        {"$ref": "#/$defs/card"},
        {"type": "null"}
      ]
    },
    "nullable_rank": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 32
    },
    "nullable_rate_gap": {
      "type": ["number", "null"],
      "minimum": -1,
      "maximum": 1
    },
    "search_aggregate_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_contract_success_count",
        "local_contract_success_rate",
        "mean_local_side_game_score",
        "mean_local_side_card_point_margin"
      ],
      "properties": {
        "local_contract_success_count": {"type": "integer", "minimum": 0},
        "local_contract_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_local_side_game_score": {"type": "number"},
        "mean_local_side_card_point_margin": {
          "type": ["number", "null"],
          "minimum": -120,
          "maximum": 120
        }
      }
    },
    "nullable_search_aggregate_metrics": {
      "oneOf": [
        {"$ref": "#/$defs/search_aggregate_metrics"},
        {"type": "null"}
      ]
    },
    "null_search_aggregate_metrics": {
      "$ref": "#/$defs/search_aggregate_metrics",
      "properties": {
        "mean_local_side_card_point_margin": {"type": "null"}
      }
    },
    "nullable_null_search_aggregate_metrics": {
      "oneOf": [
        {"$ref": "#/$defs/null_search_aggregate_metrics"},
        {"type": "null"}
      ]
    },
    "non_null_search_aggregate_metrics": {
      "$ref": "#/$defs/search_aggregate_metrics",
      "properties": {
        "mean_local_side_card_point_margin": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        }
      }
    },
    "nullable_non_null_search_aggregate_metrics": {
      "oneOf": [
        {"$ref": "#/$defs/non_null_search_aggregate_metrics"},
        {"type": "null"}
      ]
    },
    "search_actual_card_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_available",
        "unavailable_reason",
        "actual_card",
        "search_recommended_card",
        "actual_card_rank",
        "recommended_card_rank",
        "actual_card_is_best_aggregate",
        "actual_card_is_aggregate_equivalent_to_recommendation",
        "strictly_better_card_count",
        "completed_world_count",
        "comparison_basis",
        "actual_card_metrics",
        "recommended_card_metrics",
        "contract_success_rate_gap",
        "mean_local_side_game_score_gap",
        "mean_local_side_card_point_margin_gap"
      ],
      "properties": {
        "is_available": {"type": "boolean"},
        "unavailable_reason": {
          "type": ["string", "null"],
          "enum": [
             null,
             "no_completed_search_worlds",
             "actual_card_not_provided",
             "actual_card_not_in_search_candidates",
             "search_card_not_available"
          ]
        },
        "actual_card": {"$ref": "#/$defs/nullable_card"},
        "search_recommended_card": {"$ref": "#/$defs/nullable_card"},
        "actual_card_rank": {"$ref": "#/$defs/nullable_rank"},
        "recommended_card_rank": {"$ref": "#/$defs/nullable_rank"},
        "actual_card_is_best_aggregate": {"type": ["boolean", "null"]},
        "actual_card_is_aggregate_equivalent_to_recommendation": {
          "type": ["boolean", "null"]
        },
        "strictly_better_card_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 31
        },
        "completed_world_count": {"type": "integer", "minimum": 0},
        "comparison_basis": {
          "type": ["string", "null"],
          "enum": [
            null,
            "all_compatible_worlds",
            "sampled_compatible_worlds",
            "completed_common_prefix"
          ]
        },
        "actual_card_metrics": {
          "$ref": "#/$defs/nullable_search_aggregate_metrics"
        },
        "recommended_card_metrics": {
          "$ref": "#/$defs/nullable_search_aggregate_metrics"
        },
        "contract_success_rate_gap": {"$ref": "#/$defs/nullable_rate_gap"},
        "mean_local_side_game_score_gap": {"type": ["number", "null"]},
        "mean_local_side_card_point_margin_gap": {
          "type": ["number", "null"],
          "minimum": -240,
          "maximum": 240
        }
      },
      "if": {
        "properties": {"is_available": {"const": true}},
        "required": ["is_available"]
      },
      "then": {
        "properties": {
          "unavailable_reason": {"type": "null"},
          "actual_card": {"$ref": "#/$defs/card"},
          "search_recommended_card": {"$ref": "#/$defs/card"},
          "actual_card_rank": {"type": "integer"},
          "recommended_card_rank": {"type": "integer"},
          "actual_card_is_best_aggregate": {"type": "boolean"},
          "actual_card_is_aggregate_equivalent_to_recommendation": {
            "type": "boolean"
          },
          "strictly_better_card_count": {"type": "integer"},
          "completed_world_count": {"minimum": 1},
          "comparison_basis": {"type": "string"},
          "actual_card_metrics": {"$ref": "#/$defs/search_aggregate_metrics"},
          "recommended_card_metrics": {
            "$ref": "#/$defs/search_aggregate_metrics"
          },
          "contract_success_rate_gap": {"type": "number"},
          "mean_local_side_game_score_gap": {"type": "number"}
        }
      },
      "else": {
        "properties": {
          "unavailable_reason": {"type": "string"},
          "actual_card_rank": {"type": "null"},
          "recommended_card_rank": {"type": "null"},
          "actual_card_is_best_aggregate": {"type": "null"},
          "actual_card_is_aggregate_equivalent_to_recommendation": {
            "type": "null"
          },
          "strictly_better_card_count": {"type": "null"},
          "actual_card_metrics": {"type": "null"},
          "recommended_card_metrics": {"type": "null"},
          "contract_success_rate_gap": {"type": "null"},
          "mean_local_side_game_score_gap": {"type": "null"},
          "mean_local_side_card_point_margin_gap": {"type": "null"}
        }
      }
    },
    "search_vs_immediate_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_available",
        "unavailable_reason",
        "search_card",
        "immediate_card",
        "same_recommended_card",
        "search_rank_of_immediate_card",
        "immediate_rank_of_search_card",
        "search_aggregate_relation",
        "search_contract_success_rate_advantage",
        "search_mean_game_score_advantage",
        "search_mean_card_point_margin_advantage"
      ],
      "properties": {
        "is_available": {"type": "boolean"},
        "unavailable_reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "no_completed_search_worlds",
            "search_card_not_available",
            "immediate_card_not_provided",
            "immediate_analysis_report_not_available",
            "immediate_card_not_in_search_candidates",
            "search_card_not_in_immediate_analysis_report",
            "immediate_card_not_in_immediate_analysis_report"
          ]
        },
        "search_card": {"$ref": "#/$defs/nullable_card"},
        "immediate_card": {"$ref": "#/$defs/nullable_card"},
        "same_recommended_card": {"type": ["boolean", "null"]},
        "search_rank_of_immediate_card": {"$ref": "#/$defs/nullable_rank"},
        "immediate_rank_of_search_card": {"$ref": "#/$defs/nullable_rank"},
        "search_aggregate_relation": {
          "type": "string",
          "enum": ["search_better", "aggregate_equivalent", "not_available"]
        },
        "search_contract_success_rate_advantage": {
          "$ref": "#/$defs/nullable_rate_gap"
        },
        "search_mean_game_score_advantage": {"type": ["number", "null"]},
        "search_mean_card_point_margin_advantage": {
          "type": ["number", "null"],
          "minimum": -240,
          "maximum": 240
        }
      },
      "if": {
        "properties": {"is_available": {"const": true}},
        "required": ["is_available"]
      },
      "then": {
        "properties": {
          "unavailable_reason": {"type": "null"},
          "search_card": {"$ref": "#/$defs/card"},
          "immediate_card": {"$ref": "#/$defs/card"},
          "same_recommended_card": {"type": "boolean"},
          "search_rank_of_immediate_card": {"type": "integer"},
          "immediate_rank_of_search_card": {"type": "integer"},
          "search_aggregate_relation": {
            "enum": ["search_better", "aggregate_equivalent"]
          },
          "search_contract_success_rate_advantage": {"type": "number"},
          "search_mean_game_score_advantage": {"type": "number"}
        }
      },
      "else": {
        "properties": {
          "unavailable_reason": {"type": "string"},
          "same_recommended_card": {"type": "null"},
          "search_rank_of_immediate_card": {"type": "null"},
          "immediate_rank_of_search_card": {"type": "null"},
          "search_aggregate_relation": {"const": "not_available"},
          "search_contract_success_rate_advantage": {"type": "null"},
          "search_mean_game_score_advantage": {"type": "null"},
          "search_mean_card_point_margin_advantage": {"type": "null"}
        }
      }
    }
  }
}
