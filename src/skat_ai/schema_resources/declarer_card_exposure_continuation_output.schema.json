{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/declarer_card_exposure_continuation_output.schema.json",
  "title": "skat-ai declarer card exposure continuation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "rule_sections",
    "declarer_player",
    "exposure_form",
    "shown_to_player",
    "defender_responses",
    "continuing_defenders",
    "accepting_defenders",
    "unanimous_acceptance",
    "continuation_required",
    "public_declarer_cards",
    "public_declarer_card_count",
    "card_reconciliation",
    "visibility_scope",
    "claimed_play_level",
    "claimed_play_level_status",
    "game_end_applied",
    "settlement_applied"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "declarer_card_exposure"},
    "rule_sections": {
      "type": "array",
      "prefixItems": [{"const": "4.4.4"}],
      "minItems": 1,
      "maxItems": 1
    },
    "declarer_player": {"$ref": "#/$defs/player"},
    "exposure_form": {
      "type": "string",
      "enum": ["laid_open", "shown_to_defender"]
    },
    "shown_to_player": {
      "type": ["string", "null"],
      "enum": ["me", "left", "right", null]
    },
    "defender_responses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/response"}
    },
    "continuing_defenders": {"$ref": "#/$defs/player_array"},
    "accepting_defenders": {"$ref": "#/$defs/player_array"},
    "unanimous_acceptance": {"const": false},
    "continuation_required": {"const": true},
    "public_declarer_cards": {"$ref": "#/$defs/cards"},
    "public_declarer_card_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "card_reconciliation": {
      "type": "string",
      "enum": ["confirmed", "not_verifiable"]
    },
    "visibility_scope": {"const": "all_players"},
    "claimed_play_level": {
      "type": "string",
      "enum": ["simple", "schneider", "schwarz"]
    },
    "claimed_play_level_status": {
      "const": "continuation_required_no_immediate_settlement_effect"
    },
    "game_end_applied": {"const": false},
    "settlement_applied": {"const": false}
  },
  "$defs": {
    "player": {
      "type": "string",
      "enum": ["me", "left", "right"]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
      }
    },
    "player_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/player"}
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player", "response", "form"],
      "properties": {
        "player": {"$ref": "#/$defs/player"},
        "response": {
          "type": "string",
          "enum": ["accept", "continue"]
        },
        "form": {
          "type": "string",
          "enum": ["explicit", "unambiguous_conduct"]
        }
      }
    }
  }
}
