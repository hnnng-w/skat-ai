{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/fixed_three_player_historical_list_aggregation.schema.json",
  "title": "skat-ai fixed-three-player historical-list aggregation version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregation_version",
    "basis",
    "source_list_schema_version",
    "list_id",
    "entry_count",
    "round_count",
    "played_game_count",
    "passed_deal_count",
    "declarer_win_count",
    "declarer_loss_count",
    "player_totals",
    "progression",
    "ranking_status",
    "tied_player_ids",
    "lot_required_player_ids",
    "applied_lot_order",
    "final_standings"
  ],
  "properties": {
    "aggregation_version": {"const": 1},
    "basis": {"const": "fixed_three_player_historical_36_position_list"},
    "source_list_schema_version": {"const": 1},
    "list_id": {"$ref": "#/$defs/stable_identifier"},
    "entry_count": {"const": 36},
    "round_count": {"const": 12},
    "played_game_count": {"$ref": "#/$defs/list_count"},
    "passed_deal_count": {"$ref": "#/$defs/list_count"},
    "declarer_win_count": {"$ref": "#/$defs/list_count"},
    "declarer_loss_count": {"$ref": "#/$defs/list_count"},
    "player_totals": {"$ref": "#/$defs/three_player_totals"},
    "progression": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {"$ref": "#/$defs/progression_snapshot"}
    },
    "ranking_status": {"$ref": "#/$defs/ranking_status"},
    "tied_player_ids": {"$ref": "#/$defs/player_id_array"},
    "lot_required_player_ids": {"$ref": "#/$defs/player_id_array"},
    "applied_lot_order": {"$ref": "#/$defs/nullable_lot_order"},
    "final_standings": {"$ref": "#/$defs/three_standings"}
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    },
    "nullable_label": {
      "oneOf": [
        {"$ref": "#/$defs/stable_identifier"},
        {"type": "null"}
      ]
    },
    "table_place": {"enum": ["place_1", "place_2", "place_3"]},
    "ranking_status": {"enum": ["final", "lot_required"]},
    "non_negative_integer": {"type": "integer", "minimum": 0},
    "list_count": {"type": "integer", "minimum": 0, "maximum": 36},
    "player_id_array": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_identifier"}
    },
    "nullable_lot_order": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_identifier"}
        }
      ]
    },
    "player_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "player_label",
        "table_place",
        "list_entry_count",
        "played_game_count",
        "passed_deal_count",
        "declarer_game_count",
        "defender_game_count",
        "own_games_won",
        "own_games_lost",
        "defender_games_won",
        "defender_games_lost",
        "other_players_lost_games",
        "player_game_points",
        "own_game_bonus_points",
        "opponent_loss_bonus_points",
        "total_performance_points"
      ],
      "properties": {
        "player_id": {"$ref": "#/$defs/stable_identifier"},
        "player_label": {"$ref": "#/$defs/nullable_label"},
        "table_place": {"$ref": "#/$defs/table_place"},
        "list_entry_count": {"$ref": "#/$defs/list_count"},
        "played_game_count": {"$ref": "#/$defs/list_count"},
        "passed_deal_count": {"$ref": "#/$defs/list_count"},
        "declarer_game_count": {"$ref": "#/$defs/list_count"},
        "defender_game_count": {"$ref": "#/$defs/list_count"},
        "own_games_won": {"$ref": "#/$defs/list_count"},
        "own_games_lost": {"$ref": "#/$defs/list_count"},
        "defender_games_won": {"$ref": "#/$defs/list_count"},
        "defender_games_lost": {"$ref": "#/$defs/list_count"},
        "other_players_lost_games": {"$ref": "#/$defs/list_count"},
        "player_game_points": {"type": "integer"},
        "own_game_bonus_points": {"type": "integer"},
        "opponent_loss_bonus_points": {"type": "integer"},
        "total_performance_points": {"type": "integer"}
      }
    },
    "three_player_totals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/player_totals"}
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "list_entry_count",
        "played_game_count",
        "passed_deal_count",
        "declarer_game_count",
        "defender_game_count",
        "own_games_won",
        "own_games_lost",
        "defender_games_won",
        "defender_games_lost",
        "other_players_lost_games",
        "player_game_points",
        "own_game_bonus_points",
        "opponent_loss_bonus_points",
        "total_performance_points"
      ],
      "properties": {
        "player_id": {"$ref": "#/$defs/stable_identifier"},
        "list_entry_count": {"const": 1},
        "played_game_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "passed_deal_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "declarer_game_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "defender_game_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "own_games_won": {"type": "integer", "minimum": 0, "maximum": 1},
        "own_games_lost": {"type": "integer", "minimum": 0, "maximum": 1},
        "defender_games_won": {"type": "integer", "minimum": 0, "maximum": 1},
        "defender_games_lost": {"type": "integer", "minimum": 0, "maximum": 1},
        "other_players_lost_games": {"type": "integer", "minimum": 0, "maximum": 1},
        "player_game_points": {"type": "integer"},
        "own_game_bonus_points": {"type": "integer"},
        "opponent_loss_bonus_points": {"type": "integer"},
        "total_performance_points": {"type": "integer"}
      }
    },
    "seat_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dealer_player_id",
        "forehand_player_id",
        "middlehand_player_id",
        "rearhand_player_id"
      ],
      "properties": {
        "dealer_player_id": {"$ref": "#/$defs/stable_identifier"},
        "forehand_player_id": {"$ref": "#/$defs/stable_identifier"},
        "middlehand_player_id": {"$ref": "#/$defs/stable_identifier"},
        "rearhand_player_id": {"$ref": "#/$defs/stable_identifier"}
      }
    },
    "entry_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "list_id",
        "entry_number",
        "round_number",
        "entry_id",
        "entry_kind",
        "entry_outcome",
        "played_at",
        "dealer_player_id",
        "seat_assignment",
        "game_id",
        "game_end_reason",
        "declarer_player_id",
        "settlement_score",
        "player_contributions"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "list_id": {"$ref": "#/$defs/stable_identifier"},
        "entry_number": {"type": "integer", "minimum": 1, "maximum": 36},
        "round_number": {"type": "integer", "minimum": 1, "maximum": 12},
        "entry_id": {"$ref": "#/$defs/stable_identifier"},
        "entry_kind": {"enum": ["played_game", "passed_deal"]},
        "entry_outcome": {"enum": ["declarer_win", "declarer_loss", "passed_deal"]},
        "played_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "dealer_player_id": {"$ref": "#/$defs/stable_identifier"},
        "seat_assignment": {"$ref": "#/$defs/seat_assignment"},
        "game_id": {
          "oneOf": [
            {"$ref": "#/$defs/stable_identifier"},
            {"type": "null"}
          ]
        },
        "game_end_reason": {
          "oneOf": [
            {
              "enum": [
                "normal_completion",
                "declarer_concession",
                "defender_concession",
                "declarer_card_exposure",
                "defender_open_play",
                "open_card_throw"
              ]
            },
            {"type": "null"}
          ]
        },
        "declarer_player_id": {
          "oneOf": [
            {"$ref": "#/$defs/stable_identifier"},
            {"type": "null"}
          ]
        },
        "settlement_score": {
          "oneOf": [{"type": "integer"}, {"type": "null"}]
        },
        "player_contributions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/contribution"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"entry_kind": {"const": "passed_deal"}}},
          "then": {
            "properties": {
              "entry_outcome": {"const": "passed_deal"},
              "game_id": {"type": "null"},
              "game_end_reason": {"type": "null"},
              "declarer_player_id": {"type": "null"},
              "settlement_score": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "entry_outcome": {"enum": ["declarer_win", "declarer_loss"]},
              "game_id": {"$ref": "#/$defs/stable_identifier"},
              "game_end_reason": {
                "enum": [
                  "normal_completion",
                  "declarer_concession",
                  "defender_concession",
                  "declarer_card_exposure",
                  "defender_open_play",
                  "open_card_throw"
                ]
              },
              "declarer_player_id": {"$ref": "#/$defs/stable_identifier"},
              "settlement_score": {"type": "integer"}
            }
          }
        }
      ]
    },
    "standing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "player_totals"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "player_totals": {"$ref": "#/$defs/player_totals"}
      }
    },
    "three_standings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/standing"}
    },
    "progression_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation_version",
        "list_id",
        "entry_fact",
        "cumulative_player_totals",
        "provisional_standings",
        "tied_player_ids"
      ],
      "properties": {
        "aggregation_version": {"const": 1},
        "list_id": {"$ref": "#/$defs/stable_identifier"},
        "entry_fact": {"$ref": "#/$defs/entry_fact"},
        "cumulative_player_totals": {"$ref": "#/$defs/three_player_totals"},
        "provisional_standings": {"$ref": "#/$defs/three_standings"},
        "tied_player_ids": {"$ref": "#/$defs/player_id_array"}
      }
    }
  }
}
