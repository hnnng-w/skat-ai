{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/historical_declarer_concession.schema.json",
  "title": "skatmind historical declarer-concession event version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "declarer_hand_cards_remaining",
    "defender_consent"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "declarer_concession"},
    "declarer_hand_cards_remaining": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "defender_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "consenting_defender_player_ids"],
      "properties": {
        "status": {"enum": ["not_required", "granted"]},
        "consenting_defender_player_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stable_identifier"},
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    }
  }
}
