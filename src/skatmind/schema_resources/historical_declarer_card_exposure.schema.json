{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/historical_declarer_card_exposure.schema.json",
  "title": "skatmind historical declarer-card-exposure event version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "exposure",
    "claimed_play_level",
    "defender_responses"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "declarer_card_exposure"},
    "exposure": {
      "oneOf": [
        {"$ref": "#/$defs/laid_open_exposure"},
        {"$ref": "#/$defs/shown_to_defender_exposure"}
      ]
    },
    "claimed_play_level": {
      "enum": ["simple", "schneider", "schwarz"]
    },
    "defender_responses": {
      "type": "array",
      "items": {"$ref": "#/$defs/defender_response"},
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    }
  },
  "$defs": {
    "stable_defender_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!me$|left$|right$)(?:[\\s\\S]*\\S)?$"
    },
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "exposed_cards": {
      "type": "array",
      "items": {"$ref": "#/$defs/card"},
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "laid_open_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "exposed_cards"],
      "properties": {
        "form": {"const": "laid_open"},
        "exposed_cards": {"$ref": "#/$defs/exposed_cards"}
      }
    },
    "shown_to_defender_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "exposed_cards", "shown_to_defender_player_id"],
      "properties": {
        "form": {"const": "shown_to_defender"},
        "exposed_cards": {"$ref": "#/$defs/exposed_cards"},
        "shown_to_defender_player_id": {
          "$ref": "#/$defs/stable_defender_identifier"
        }
      }
    },
    "defender_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defender_player_id", "response", "form"],
      "properties": {
        "defender_player_id": {"$ref": "#/$defs/stable_defender_identifier"},
        "response": {"const": "accept"},
        "form": {"enum": ["explicit", "unambiguous_conduct"]}
      }
    }
  }
}
