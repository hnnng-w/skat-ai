{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/historical_defender_open_play_output.schema.json",
  "title": "skatmind historical defender-open-play output version 1",
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!me$|left$|right$)(?:[\\s\\S]*\\S)?$"
    },
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "proof_line": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "player_id",
          "card",
          "card_visibility",
          "trick_winner_player_id"
        ],
        "properties": {
          "player_id": {"$ref": "#/$defs/stable_identifier"},
          "card": {
            "oneOf": [{"$ref": "#/$defs/card"}, {"type": "null"}]
          },
          "card_visibility": {
            "enum": ["exposed", "private_evidence_redacted"]
          },
          "trick_winner_player_id": {
            "oneOf": [
              {"$ref": "#/$defs/stable_identifier"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "exact_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "proof_complete",
        "quantifier_policy",
        "evaluated_state_count",
        "memoized_state_count",
        "counterexample_found"
      ],
      "properties": {
        "status": {"enum": ["valid", "invalid"]},
        "proof_complete": {"const": true},
        "quantifier_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exposing_defender", "declarer", "non_exposing_defender"],
          "properties": {
            "exposing_defender": {"const": "exists_legal_strategy"},
            "declarer": {"const": "all_legal_plays"},
            "non_exposing_defender": {"const": "all_legal_plays"}
          }
        },
        "evaluated_state_count": {"type": "integer", "minimum": 1},
        "memoized_state_count": {"type": "integer", "minimum": 1},
        "counterexample_found": {"type": "boolean"},
        "successful_line": {"$ref": "#/$defs/proof_line"},
        "counterexample_line": {"$ref": "#/$defs/proof_line"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "valid"}}},
          "then": {
            "required": ["successful_line"],
            "properties": {"counterexample_found": {"const": false}},
            "not": {"required": ["counterexample_line"]}
          },
          "else": {
            "required": ["counterexample_line"],
            "properties": {"counterexample_found": {"const": true}},
            "not": {"required": ["successful_line"]}
          }
        }
      ]
    },
    "point_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_trick_declarer_points",
        "completed_trick_defender_points",
        "skat_points",
        "observed_declarer_points",
        "observed_defender_points",
        "unresolved_current_trick_points",
        "unresolved_remaining_hand_points",
        "total_unresolved_points",
        "total_card_points",
        "assigned_declarer_points",
        "assigned_defender_points",
        "final_declarer_points",
        "final_defender_points"
      ],
      "properties": {
        "completed_trick_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "completed_trick_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "skat_points": {"type": "integer", "minimum": 0, "maximum": 22},
        "observed_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "observed_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "unresolved_current_trick_points": {"type": "integer", "minimum": 0, "maximum": 22},
        "unresolved_remaining_hand_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "total_unresolved_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "total_card_points": {"const": 120},
        "assigned_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "assigned_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "final_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "final_defender_points": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "game_end_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "rule_sections",
        "declarer_player_id",
        "exposing_defender_player_id",
        "non_exposing_defender_player_id",
        "defending_party_player_ids",
        "exposed_cards",
        "exposed_card_count",
        "card_reconciliation",
        "declarer_response",
        "decision_state_before_shortening",
        "remaining_trick_count",
        "exact_proof",
        "rest_trick_assignment",
        "rest_tricks_recipient",
        "adjudicated_winner",
        "winner_basis",
        "continued_play_requested",
        "event_after_play_count",
        "event_after_completed_trick_count",
        "event_during_incomplete_trick"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "defender_open_play"},
        "rule_sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"enum": ["4.4.5", "4.1.3", "4.1.4", "4.1.5"]},
          "prefixItems": [{"const": "4.4.5"}]
        },
        "declarer_player_id": {"$ref": "#/$defs/stable_identifier"},
        "exposing_defender_player_id": {"$ref": "#/$defs/stable_identifier"},
        "non_exposing_defender_player_id": {"$ref": "#/$defs/stable_identifier"},
        "defending_party_player_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stable_identifier"},
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "exposed_cards": {
          "type": "array",
          "items": {"$ref": "#/$defs/card"},
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "exposed_card_count": {"type": "integer", "minimum": 1, "maximum": 5},
        "card_reconciliation": {"const": "confirmed"},
        "declarer_response": {"const": "accept_adjudication"},
        "decision_state_before_shortening": {
          "enum": ["undecided", "declarer_already_won", "defenders_already_won"]
        },
        "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 5},
        "exact_proof": {"$ref": "#/$defs/exact_proof"},
        "rest_trick_assignment": {
          "$ref": "https://example.local/skatmind/defender_open_play_output.schema.json#/$defs/rest_trick_assignment"
        },
        "rest_tricks_recipient": {"enum": ["declarer", "defenders"]},
        "adjudicated_winner": {"enum": ["declarer", "defenders"]},
        "winner_basis": {
          "enum": [
            "preexisting_game_decision",
            "valid_defender_open_play",
            "invalid_defender_open_play"
          ]
        },
        "continued_play_requested": {"const": false},
        "event_after_play_count": {"type": "integer", "minimum": 15, "maximum": 29},
        "event_after_completed_trick_count": {"type": "integer", "minimum": 5, "maximum": 9},
        "event_during_incomplete_trick": {"type": "boolean"}
      }
    }
  }
}
