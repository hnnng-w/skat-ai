{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/historical_open_card_throw_output.schema.json",
  "title": "skatmind historical open-card-throw output version 1",
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!me$|left$|right$)(?:[\\s\\S]*\\S)?$"
    },
    "party": {"enum": ["declarer", "defenders"]},
    "card": {"type": "string", "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"},
    "party_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declarer", "defenders"],
      "properties": {
        "declarer": {"type": "integer", "minimum": 0, "maximum": 120},
        "defenders": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "game_end_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "rule_sections",
        "declarer_player_id",
        "throwing_player_id",
        "throwing_party",
        "opposing_party",
        "joint_liability",
        "thrown_cards",
        "thrown_card_count",
        "card_reconciliation",
        "statement_classification",
        "decision_state_before_shortening",
        "rest_trick_assignment",
        "rest_tricks_recipient",
        "remaining_trick_count",
        "observed_trick_counts",
        "rule_assigned_trick_counts",
        "final_trick_counts",
        "observed_points",
        "rule_assigned_points",
        "final_points",
        "adjudicated_winner",
        "winner_basis",
        "schneider_rule_level_applied",
        "schwarz_rule_level_applied",
        "theoretical_schwarz_status",
        "theoretical_schwarz_assessment",
        "continued_play_supported",
        "event_after_play_count",
        "event_after_completed_trick_count",
        "event_during_incomplete_trick"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "open_card_throw"},
        "rule_sections": {
          "type": "array",
          "prefixItems": [{"const": "4.4.6"}],
          "minItems": 1,
          "maxItems": 1
        },
        "declarer_player_id": {"$ref": "#/$defs/stable_identifier"},
        "throwing_player_id": {"$ref": "#/$defs/stable_identifier"},
        "throwing_party": {"$ref": "#/$defs/party"},
        "opposing_party": {"$ref": "#/$defs/party"},
        "joint_liability": {"type": "boolean"},
        "thrown_cards": {
          "type": "array",
          "items": {"$ref": "#/$defs/card"},
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "thrown_card_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "card_reconciliation": {"const": "confirmed"},
        "statement_classification": {
          "enum": ["none", "generic_concession", "attempted_level_limitation"]
        },
        "decision_state_before_shortening": {
          "enum": ["undecided", "declarer_already_won", "defenders_already_won"]
        },
        "rest_trick_assignment": {
          "$ref": "https://example.local/skatmind/open_card_throw_output.schema.json#/$defs/rest_trick_assignment"
        },
        "rest_tricks_recipient": {"$ref": "#/$defs/party"},
        "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "observed_trick_counts": {"$ref": "#/$defs/party_counts"},
        "rule_assigned_trick_counts": {"$ref": "#/$defs/party_counts"},
        "final_trick_counts": {"$ref": "#/$defs/party_counts"},
        "observed_points": {"$ref": "#/$defs/party_counts"},
        "rule_assigned_points": {"$ref": "#/$defs/party_counts"},
        "final_points": {"$ref": "#/$defs/party_counts"},
        "adjudicated_winner": {"$ref": "#/$defs/party"},
        "winner_basis": {
          "enum": [
            "open_card_throw_rule_state",
            "preexisting_game_decision",
            "failed_mandatory_level",
            "uncovered_overbid_requirement",
            "theoretically_excluded_required_schwarz"
          ]
        },
        "schneider_rule_level_applied": {"type": "boolean"},
        "schwarz_rule_level_applied": {"type": "boolean"},
        "theoretical_schwarz_status": {"enum": ["not_excluded", "excluded"]},
        "theoretical_schwarz_assessment": {
          "$ref": "https://example.local/skatmind/theoretical_level_assessment.schema.json"
        },
        "continued_play_supported": {"const": false},
        "event_after_play_count": {"type": "integer", "minimum": 0, "maximum": 29},
        "event_after_completed_trick_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "event_during_incomplete_trick": {"type": "boolean"}
      }
    }
  }
}
