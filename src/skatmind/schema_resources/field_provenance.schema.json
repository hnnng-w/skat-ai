{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/field_provenance.schema.json",
  "title": "skatmind public field provenance bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_version",
    "workflow",
    "redaction_policy",
    "result",
    "artifacts"
  ],
  "properties": {
    "provenance_version": {"const": 1},
    "workflow": {"$ref": "#/$defs/workflow"},
    "redaction_policy": {"const": "omit_engine_private_details"},
    "result": {"$ref": "#/$defs/result_attachment"},
    "artifacts": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"workflow": {"const": "position_analysis"}}},
      "then": {
        "properties": {
          "result": {
            "properties": {
              "attachment_name": {"const": "position_result"},
              "information_use_context": {
                "properties": {"workflow": {"const": "position_analysis"}}
              }
            }
          },
          "artifacts": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"workflow": {"const": "historical_game"}}},
      "then": {
        "properties": {
          "result": {
            "properties": {
              "attachment_name": {"const": "historical_game_result"},
              "information_use_context": {
                "properties": {"workflow": {"const": "historical_game"}}
              }
            }
          },
          "artifacts": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"workflow": {"const": "training_dataset"}}},
      "then": {
        "properties": {
          "result": {
            "properties": {
              "attachment_name": {"const": "training_dataset_result"},
              "information_use_context": {
                "properties": {"workflow": {"const": "training_dataset"}}
              }
            }
          },
          "artifacts": {
            "items": {
              "properties": {
                "attachment": {
                  "properties": {
                    "information_use_context": {
                      "properties": {"workflow": {"const": "training_dataset"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"workflow": {"const": "training_dataset_preparation"}}
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "attachment_name": {"const": "dataset_preparation_result"},
              "information_use_context": {
                "properties": {
                  "workflow": {"const": "training_dataset_preparation"}
                }
              }
            }
          },
          "artifacts": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"workflow": {"const": "opponent_statistics"}}},
      "then": {
        "properties": {
          "result": {
            "properties": {
              "attachment_name": {"const": "opponent_statistics_result"},
              "information_use_context": {
                "properties": {"workflow": {"const": "opponent_statistics"}}
              }
            }
          },
          "artifacts": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {"const": "fixed_three_player_historical_list"}
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "attachment_name": {"const": "historical_list_result"},
              "information_use_context": {
                "properties": {
                  "workflow": {"const": "fixed_three_player_historical_list"}
                }
              }
            }
          },
          "artifacts": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "const": "fixed_three_player_historical_list_comparison"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "attachment_name": {"const": "historical_list_comparison_result"},
              "information_use_context": {
                "properties": {
                  "workflow": {
                    "const": "fixed_three_player_historical_list_comparison"
                  }
                }
              }
            }
          },
          "artifacts": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "workflow": {
      "type": "string",
      "enum": [
        "position_analysis",
        "historical_game",
        "training_dataset",
        "training_dataset_preparation",
        "opponent_statistics",
        "fixed_three_player_historical_list",
        "fixed_three_player_historical_list_comparison"
      ]
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "coverage_kind": {
      "type": "string",
      "enum": ["field", "subtree"]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "local_private",
        "declarer_private",
        "defender_private",
        "post_game_only"
      ]
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "reference_id",
        "field_path",
        "visibility"
      ],
      "properties": {
        "reference_type": {
          "type": "string",
          "enum": [
            "request",
            "historical_game",
            "historical_event",
            "external_record",
            "rule_contract",
            "algorithm",
            "aggregate",
            "retrospective_observation",
            "dataset_plan"
          ]
        },
        "reference_id": {"type": "string", "minLength": 1},
        "field_path": {
          "oneOf": [
            {"$ref": "#/$defs/json_pointer"},
            {"type": "null"}
          ]
        },
        "visibility": {"$ref": "#/$defs/visibility"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "coverage_kind",
        "origin",
        "visibility",
        "available_from",
        "available_from_decision_index",
        "available_from_event_index",
        "derivation",
        "source_references",
        "dependency_paths",
        "subject_player_id",
        "perspective_player_id"
      ],
      "properties": {
        "field_path": {"$ref": "#/$defs/json_pointer"},
        "coverage_kind": {"$ref": "#/$defs/coverage_kind"},
        "origin": {
          "type": "string",
          "enum": [
            "caller_supplied",
            "defaulted",
            "validated_copy",
            "public_game_event",
            "historical_replay",
            "external_source",
            "rule_derived",
            "structural_inference",
            "compatible_world_aggregate",
            "sampled_estimate",
            "heuristic_analysis",
            "simulation_derived",
            "search_derived",
            "retrospective_attachment",
            "historical_aggregation",
            "dataset_assignment"
          ]
        },
        "visibility": {"$ref": "#/$defs/visibility"},
        "available_from": {
          "type": "string",
          "enum": [
            "request_start",
            "current_decision",
            "after_public_event",
            "after_actual_play",
            "game_end",
            "offline_review"
          ]
        },
        "available_from_decision_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "available_from_event_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "derivation": {
          "type": "string",
          "enum": [
            "direct",
            "validated",
            "deterministic_rule",
            "reconstruction",
            "exact_aggregate",
            "sampled_aggregate",
            "heuristic",
            "retrospective"
          ]
        },
        "source_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_reference"}
        },
        "dependency_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/json_pointer"}
        },
        "subject_player_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "perspective_player_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "coverage_kind", "reason"],
      "properties": {
        "field_path": {"$ref": "#/$defs/json_pointer"},
        "coverage_kind": {"$ref": "#/$defs/coverage_kind"},
        "reason": {
          "type": "string",
          "enum": ["schema_constant", "not_applicable"]
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_version",
        "status",
        "entries",
        "exemptions",
        "limitations"
      ],
      "properties": {
        "provenance_version": {"const": 1},
        "status": {"const": "complete"},
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/entry"}
        },
        "exemptions": {
          "type": "array",
          "items": {"$ref": "#/$defs/exemption"}
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"const": "private_dependencies_redacted"}
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf_path_count",
        "provenanced_path_count",
        "exempted_path_count",
        "uncovered_paths",
        "orphaned_entry_paths",
        "orphaned_exemption_paths",
        "overlapping_paths",
        "all_paths_accounted_for",
        "provenance_complete"
      ],
      "properties": {
        "leaf_path_count": {"type": "integer", "minimum": 0},
        "provenanced_path_count": {"type": "integer", "minimum": 0},
        "exempted_path_count": {"type": "integer", "minimum": 0},
        "uncovered_paths": {"type": "array", "maxItems": 0},
        "orphaned_entry_paths": {"type": "array", "maxItems": 0},
        "orphaned_exemption_paths": {"type": "array", "maxItems": 0},
        "overlapping_paths": {"type": "array", "maxItems": 0},
        "all_paths_accounted_for": {"const": true},
        "provenance_complete": {"const": true}
      }
    },
    "information_use_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "stage",
        "perspective_player_id",
        "perspective_side",
        "decision_index",
        "event_index"
      ],
      "properties": {
        "workflow": {"$ref": "#/$defs/workflow"},
        "stage": {
          "type": "string",
          "enum": [
            "request_start",
            "decision_time",
            "after_actual_play",
            "game_end",
            "offline_review",
            "engine_internal"
          ]
        },
        "perspective_player_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "perspective_side": {
          "oneOf": [
            {"type": "string", "enum": ["declarer", "defenders"]},
            {"type": "null"}
          ]
        },
        "decision_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "event_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_name",
        "document_role",
        "document_scope",
        "ledger",
        "coverage_summary",
        "information_use_context"
      ],
      "properties": {
        "attachment_name": {"type": "string", "minLength": 1},
        "document_role": {"const": "result"},
        "document_scope": {
          "type": "string",
          "enum": [
            "root_result_without_field_provenance",
            "artifact_document"
          ]
        },
        "ledger": {"$ref": "#/$defs/ledger"},
        "coverage_summary": {"$ref": "#/$defs/coverage_summary"},
        "information_use_context": {
          "$ref": "#/$defs/information_use_context"
        }
      }
    },
    "result_attachment": {
      "allOf": [
        {"$ref": "#/$defs/attachment"},
        {
          "properties": {
            "document_scope": {"const": "root_result_without_field_provenance"}
          }
        }
      ]
    },
    "artifact_attachment": {
      "allOf": [
        {"$ref": "#/$defs/attachment"},
        {
          "properties": {
            "attachment_name": {
              "const": "training_dataset/opponent_statistics_input"
            },
            "document_scope": {"const": "artifact_document"}
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_name", "attachment"],
      "properties": {
        "artifact_name": {"const": "opponent_statistics_input"},
        "attachment": {"$ref": "#/$defs/artifact_attachment"}
      }
    }
  }
}
