{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/defender_open_play_output.schema.json",
  "title": "skatmind defender open-play output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "rule_sections",
    "exposing_defender",
    "non_exposing_defender",
    "defending_party",
    "exposed_cards",
    "exposed_card_count",
    "declarer_response",
    "decision_state_before_shortening",
    "remaining_trick_count",
    "exact_proof",
    "rest_trick_assignment",
    "rest_tricks_recipient",
    "adjudicated_winner",
    "winner_basis",
    "continued_play_requested"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "defender_open_play"},
    "rule_sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string", "enum": ["4.4.5", "4.1.3", "4.1.4", "4.1.5"]},
      "prefixItems": [{"const": "4.4.5"}]
    },
    "exposing_defender": {"$ref": "#/$defs/player"},
    "non_exposing_defender": {"$ref": "#/$defs/player"},
    "defending_party": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/player"}
    },
    "exposed_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/card"}
    },
    "exposed_card_count": {"type": "integer", "minimum": 1, "maximum": 5},
    "declarer_response": {"const": "accept_adjudication"},
    "decision_state_before_shortening": {"$ref": "#/$defs/decision_state"},
    "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 5},
    "exact_proof": {"$ref": "https://example.local/skatmind/exact_rest_trick_proof.schema.json"},
    "rest_trick_assignment": {"$ref": "#/$defs/rest_trick_assignment"},
    "rest_tricks_recipient": {"type": "string", "enum": ["declarer", "defenders"]},
    "adjudicated_winner": {"type": "string", "enum": ["declarer", "defenders"]},
    "winner_basis": {
      "type": "string",
      "enum": [
        "preexisting_game_decision",
        "valid_defender_open_play",
        "invalid_defender_open_play"
      ]
    },
    "continued_play_requested": {"const": false}
  },
  "$defs": {
    "player": {"type": "string", "enum": ["me", "left", "right"]},
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "decision_state": {
      "type": "string",
      "enum": ["undecided", "declarer_already_won", "defenders_already_won"]
    },
    "rest_trick_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recipient",
        "remaining_trick_count",
        "assigned_card_count",
        "assigned_card_points"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["defender_open_play_adjudication", "invalid_defender_open_play"]
        },
        "recipient": {"type": "string", "enum": ["declarer", "defenders"]},
        "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 5},
        "assigned_card_count": {"type": "integer", "minimum": 1, "maximum": 15},
        "assigned_card_points": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "settlement_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_end_kind",
        "outcome_source",
        "rest_trick_proof_status",
        "winner_basis",
        "decision_state_before_game_end",
        "rest_tricks_recipient",
        "mandatory_level_awarded",
        "mandatory_level_source",
        "achieved_schneider_applied",
        "achieved_schwarz_applied",
        "overbid_required_value_applied"
      ],
      "properties": {
        "game_end_kind": {"const": "defender_open_play"},
        "outcome_source": {
          "type": "string",
          "enum": ["exact_adjudication", "preexisting_game_decision"]
        },
        "rest_trick_proof_status": {"type": "string", "enum": ["valid", "invalid"]},
        "winner_basis": {
          "type": "string",
          "enum": [
            "preexisting_game_decision",
            "valid_defender_open_play",
            "invalid_defender_open_play"
          ]
        },
        "decision_state_before_game_end": {"$ref": "#/$defs/decision_state"},
        "rest_tricks_recipient": {"type": "string", "enum": ["declarer", "defenders"]},
        "mandatory_level_awarded": {"type": "boolean"},
        "mandatory_level_source": {
          "type": ["string", "null"],
          "enum": [
            "declared_announcement",
            "overbid_requirement",
            "declared_announcement_and_overbid_requirement",
            null
          ]
        },
        "achieved_schneider_applied": {"type": "boolean"},
        "achieved_schwarz_applied": {"type": "boolean"},
        "overbid_required_value_applied": {"type": "boolean"}
      }
    }
  }
}
