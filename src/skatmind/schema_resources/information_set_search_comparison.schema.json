{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/information_set_search_comparison.schema.json",
  "title": "skatmind information-set search comparison version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_method",
    "comparison_status",
    "unavailable_reason",
    "same_selected_world_sequence",
    "selected_world_count",
    "sampled_world_count",
    "information_set_status",
    "pimc_status",
    "information_set_recommended_card",
    "pimc_recommended_card",
    "immediate_recommended_card",
    "actual_card",
    "information_set_pimc_same_card",
    "information_set_immediate_same_card",
    "pimc_immediate_same_card",
    "information_set_actual_same_card",
    "pimc_actual_same_card",
    "immediate_actual_same_card",
    "information_set_rank_of_pimc_card",
    "pimc_rank_of_information_set_card",
    "information_set_rank_of_actual_card",
    "pimc_rank_of_actual_card",
    "information_set_minus_pimc_at_information_set_card",
    "information_set_minus_pimc_at_pimc_card",
    "strategy_fusion_mitigation_scope"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "comparison_method": {
      "const": "information_set_vs_same_selection_pimc_and_immediate_v1"
    },
    "comparison_status": {"enum": ["available", "unavailable"]},
    "unavailable_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "information_set_result_not_available",
        "information_set_result_not_complete",
        "pimc_result_not_available",
        "pimc_result_not_complete",
        "selected_world_sequence_not_shared",
        "immediate_recommendation_not_available",
        "actual_card_not_provided"
      ]
    },
    "same_selected_world_sequence": {"type": "boolean"},
    "selected_world_count": {"$ref": "#/$defs/count"},
    "sampled_world_count": {"$ref": "#/$defs/count"},
    "information_set_status": {"$ref": "#/$defs/method_status"},
    "pimc_status": {"$ref": "#/$defs/method_status"},
    "information_set_recommended_card": {"$ref": "#/$defs/nullable_card"},
    "pimc_recommended_card": {"$ref": "#/$defs/nullable_card"},
    "immediate_recommended_card": {"$ref": "#/$defs/nullable_card"},
    "actual_card": {"$ref": "#/$defs/nullable_card"},
    "information_set_pimc_same_card": {"$ref": "#/$defs/nullable_boolean"},
    "information_set_immediate_same_card": {"$ref": "#/$defs/nullable_boolean"},
    "pimc_immediate_same_card": {"$ref": "#/$defs/nullable_boolean"},
    "information_set_actual_same_card": {"$ref": "#/$defs/nullable_boolean"},
    "pimc_actual_same_card": {"$ref": "#/$defs/nullable_boolean"},
    "immediate_actual_same_card": {"$ref": "#/$defs/nullable_boolean"},
    "information_set_rank_of_pimc_card": {"$ref": "#/$defs/nullable_rank"},
    "pimc_rank_of_information_set_card": {"$ref": "#/$defs/nullable_rank"},
    "information_set_rank_of_actual_card": {"$ref": "#/$defs/nullable_rank"},
    "pimc_rank_of_actual_card": {"$ref": "#/$defs/nullable_rank"},
    "information_set_minus_pimc_at_information_set_card": {
      "$ref": "#/$defs/nullable_metric_deltas"
    },
    "information_set_minus_pimc_at_pimc_card": {
      "$ref": "#/$defs/nullable_metric_deltas"
    },
    "strategy_fusion_mitigation_scope": {
      "const": "controlled_player_over_selected_world_sequence"
    }
  },
  "if": {
    "properties": {"comparison_status": {"const": "available"}},
    "required": ["comparison_status"]
  },
  "then": {
    "properties": {
      "unavailable_reason": {"type": "null"},
      "same_selected_world_sequence": {"const": true},
      "selected_world_count": {"minimum": 1},
      "information_set_status": {"const": "complete"},
      "pimc_status": {"const": "complete"},
      "information_set_recommended_card": {"$ref": "#/$defs/card"},
      "pimc_recommended_card": {"$ref": "#/$defs/card"},
      "immediate_recommended_card": {"$ref": "#/$defs/card"},
      "actual_card": {"$ref": "#/$defs/card"},
      "information_set_pimc_same_card": {"type": "boolean"},
      "information_set_immediate_same_card": {"type": "boolean"},
      "pimc_immediate_same_card": {"type": "boolean"},
      "information_set_actual_same_card": {"type": "boolean"},
      "pimc_actual_same_card": {"type": "boolean"},
      "immediate_actual_same_card": {"type": "boolean"},
      "information_set_rank_of_pimc_card": {"type": "integer"},
      "pimc_rank_of_information_set_card": {"type": "integer"},
      "information_set_rank_of_actual_card": {"type": "integer"},
      "pimc_rank_of_actual_card": {"type": "integer"},
      "information_set_minus_pimc_at_information_set_card": {
        "$ref": "#/$defs/metric_deltas"
      },
      "information_set_minus_pimc_at_pimc_card": {
        "$ref": "#/$defs/metric_deltas"
      }
    }
  },
  "else": {"properties": {"unavailable_reason": {"type": "string"}}},
  "$defs": {
    "card": {"type": "string", "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"},
    "nullable_card": {
      "oneOf": [{"$ref": "#/$defs/card"}, {"type": "null"}]
    },
    "count": {"type": "integer", "minimum": 0},
    "method_status": {
      "enum": ["complete", "partial", "timeout", "unavailable", "not_available"]
    },
    "nullable_boolean": {"type": ["boolean", "null"]},
    "nullable_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 32},
    "metric_deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card",
        "completed_world_count",
        "local_contract_success_count_delta",
        "local_contract_success_rate_delta",
        "mean_local_side_game_score_delta",
        "mean_local_side_card_point_margin_delta"
      ],
      "properties": {
        "card": {"$ref": "#/$defs/card"},
        "completed_world_count": {"type": "integer", "minimum": 1},
        "local_contract_success_count_delta": {"type": "integer"},
        "local_contract_success_rate_delta": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mean_local_side_game_score_delta": {"type": "number"},
        "mean_local_side_card_point_margin_delta": {"type": ["number", "null"]}
      }
    },
    "nullable_metric_deltas": {
      "oneOf": [{"$ref": "#/$defs/metric_deltas"}, {"type": "null"}]
    }
  }
}
