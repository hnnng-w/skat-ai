{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/theoretical_level_assessment.schema.json",
  "title": "skatmind bounded theoretical Schwarz assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "losing_party",
    "exclusion_basis",
    "assessment_scope",
    "jack_ownership_evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["not_excluded", "excluded"]
    },
    "losing_party": {
      "type": "string",
      "enum": ["declarer", "defenders"]
    },
    "exclusion_basis": {
      "type": ["string", "null"],
      "enum": [
        "losing_party_owned_top_jack",
        "losing_party_owned_all_three_lower_jacks",
        null
      ]
    },
    "assessment_scope": {"const": "jack_only"},
    "jack_ownership_evidence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/jack_evidence"}
    }
  },
  "$defs": {
    "jack_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card", "ownership", "sources"],
      "properties": {
        "card": {
          "type": "string",
          "enum": ["CJ", "SJ", "HJ", "DJ"]
        },
        "ownership": {
          "type": "string",
          "enum": ["declarer", "defenders", "skat", "unknown"]
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "thrown_cards",
              "local_exact_hand",
              "completed_tricks",
              "current_trick",
              "skat",
              "historical_reconstructed_hand"
            ]
          }
        }
      }
    }
  }
}
