{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/fixed_three_player_historical_list_input.schema.json",
  "title": "skatmind fixed-three-player historical-list analysis request version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "historical_list", "lot_order"],
  "properties": {
    "schema_version": {"const": 1},
    "historical_list": {
      "$ref": "https://example.local/skatmind/fixed_three_player_historical_list.schema.json"
    },
    "lot_order": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_identifier"}
        }
      ]
    }
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    }
  }
}
