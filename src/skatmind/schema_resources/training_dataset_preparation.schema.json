{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/training_dataset_preparation.schema.json",
  "title": "skatmind automatic training dataset preparation request version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparation_version",
    "dataset_id",
    "dataset_version",
    "feature_generation_version",
    "target",
    "mode",
    "base_random_seed",
    "partition_weights",
    "records"
  ],
  "properties": {
    "preparation_version": {"const": 1},
    "dataset_id": {
      "$ref": "https://example.local/skatmind/training_dataset.schema.json#/$defs/stable_identifier"
    },
    "dataset_version": {
      "$ref": "https://example.local/skatmind/training_dataset.schema.json#/$defs/stable_identifier"
    },
    "feature_generation_version": {"const": 1},
    "target": {"const": "actual_card_played"},
    "mode": {"enum": ["known_opponent", "unseen_player"]},
    "base_random_seed": {"type": "integer"},
    "partition_weights": {"$ref": "#/$defs/partition_weights"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unpartitioned_record"}
    }
  },
  "$defs": {
    "partition_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 1},
        "validation": {"type": "integer", "minimum": 1},
        "test": {"type": "integer", "minimum": 1}
      }
    },
    "unpartitioned_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "provenance", "historical_game"],
      "properties": {
        "record_id": {
          "$ref": "https://example.local/skatmind/training_dataset.schema.json#/$defs/stable_identifier"
        },
        "provenance": {
          "$ref": "https://example.local/skatmind/training_dataset.schema.json#/$defs/provenance"
        },
        "historical_game": {
          "$ref": "https://example.local/skatmind/historical_game.schema.json"
        }
      }
    }
  }
}
