{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/defender_open_play_continuation_output.schema.json",
  "title": "skatmind defender open play continuation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "rule_sections",
    "declarer_player",
    "exposing_defender",
    "non_exposing_defender",
    "declarer_response",
    "cards_returned_to_hand",
    "hand_physically_open",
    "visibility_scope",
    "public_exposing_defender_cards",
    "public_exposing_defender_card_count",
    "card_reconciliation",
    "rest_trick_claim",
    "rest_trick_claim_status",
    "continued_play_effect",
    "continuation_required",
    "exact_proof_applied",
    "game_end_applied",
    "settlement_applied"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "defender_open_play"},
    "rule_sections": {
      "type": "array",
      "prefixItems": [{"const": "4.4.5"}, {"const": "4.1.6"}],
      "minItems": 2,
      "maxItems": 2
    },
    "declarer_player": {"$ref": "#/$defs/player"},
    "exposing_defender": {"$ref": "#/$defs/player"},
    "non_exposing_defender": {"$ref": "#/$defs/player"},
    "declarer_response": {"const": "request_continued_play"},
    "cards_returned_to_hand": {"const": true},
    "hand_physically_open": {"const": false},
    "visibility_scope": {"const": "all_players"},
    "public_exposing_defender_cards": {"$ref": "#/$defs/cards"},
    "public_exposing_defender_card_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "card_reconciliation": {
      "type": "string",
      "enum": ["confirmed", "not_verifiable"]
    },
    "rest_trick_claim": {"const": "all_remaining_tricks"},
    "rest_trick_claim_status": {
      "const": "not_adjudicated_due_to_continued_play"
    },
    "continued_play_effect": {"const": "open_play_consequence_disregarded"},
    "continuation_required": {"const": true},
    "exact_proof_applied": {"const": false},
    "game_end_applied": {"const": false},
    "settlement_applied": {"const": false}
  },
  "$defs": {
    "player": {
      "type": "string",
      "enum": ["me", "left", "right"]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
      }
    }
  }
}
