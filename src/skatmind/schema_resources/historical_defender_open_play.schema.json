{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/historical_defender_open_play.schema.json",
  "title": "skatmind historical defender-open-play event version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "exposing_defender_player_id",
    "exposed_cards",
    "declarer_response"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "defender_open_play"},
    "exposing_defender_player_id": {"$ref": "#/$defs/stable_identifier"},
    "exposed_cards": {
      "type": "array",
      "items": {"$ref": "#/$defs/card"},
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "declarer_response": {"const": "accept_adjudication"}
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!me$|left$|right$)(?:[\\s\\S]*\\S)?$"
    },
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    }
  }
}
