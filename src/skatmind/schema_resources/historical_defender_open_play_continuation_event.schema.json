{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/historical_defender_open_play_continuation_event.schema.json",
  "title": "skatmind historical defender-open-play continuation event version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "after_play_count",
    "exposing_defender_player_id",
    "exposed_cards",
    "declarer_response"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "defender_open_play_continuation"},
    "after_play_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 29
    },
    "exposing_defender_player_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$",
      "not": {"enum": ["me", "left", "right"]}
    },
    "exposed_cards": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "declarer_response": {"const": "request_continued_play"}
  }
}
