{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skatmind/historical_party_wide_claim.schema.json",
  "title": "skatmind historical party-wide all-remaining-Tricks Claim version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "claimant_player_id",
    "claiming_party"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "party_wide_all_remaining_tricks_claim"},
    "claimant_player_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!me$|left$|right$)(?:[\\s\\S]*\\S)?$"
    },
    "claiming_party": {"enum": ["declarer", "defenders"]}
  }
}
