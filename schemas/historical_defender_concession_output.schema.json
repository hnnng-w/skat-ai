{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/historical_defender_concession_output.schema.json",
  "title": "skat-ai historical defender-concession output fields version 1",
  "$defs": {
    "game_end_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "rule_sections",
        "conceding_defender_player_id",
        "non_conceding_defender_player_id",
        "concession_form",
        "liable_party",
        "joint_liability",
        "decision_state_before_concession",
        "adjudicated_winner",
        "winner_basis",
        "event_after_play_count",
        "event_after_completed_trick_count",
        "event_during_incomplete_trick",
        "remaining_points_assigned",
        "continued_play_requested",
        "settlement_level_policy"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "defender_concession"},
        "rule_sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "4.4.3"},
            {"enum": ["4.1.3", "4.1.4"]}
          ],
          "items": {"const": "4.1.5"}
        },
        "conceding_defender_player_id": {"$ref": "#/$defs/stable_identifier"},
        "non_conceding_defender_player_id": {"$ref": "#/$defs/stable_identifier"},
        "concession_form": {
          "enum": ["explicit_verbal", "adjudicated_unambiguous_conduct"]
        },
        "liable_party": {"const": "defenders"},
        "joint_liability": {"const": true},
        "decision_state_before_concession": {
          "enum": ["undecided", "declarer_already_won", "defenders_already_won"]
        },
        "adjudicated_winner": {"enum": ["declarer", "defenders"]},
        "winner_basis": {"enum": ["defender_concession", "preexisting_game_decision"]},
        "event_after_play_count": {"type": "integer", "minimum": 0, "maximum": 29},
        "event_after_completed_trick_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "event_during_incomplete_trick": {"type": "boolean"},
        "remaining_points_assigned": {"const": false},
        "continued_play_requested": {"const": false},
        "settlement_level_policy": {
          "enum": [
            "declared_or_mandatory_value_without_optional_achieved_levels",
            "secured_observed_levels_only"
          ]
        }
      }
    },
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    }
  }
}
