{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/training_dataset_preparation_output.schema.json",
  "title": "skat-ai automatic training dataset preparation output version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparation_version",
    "plan",
    "training_dataset_input",
    "partition_audit"
  ],
  "properties": {
    "preparation_version": {"const": 1},
    "plan": {
      "$ref": "https://example.local/skat-ai/dataset_partition_plan.schema.json"
    },
    "training_dataset_input": {
      "oneOf": [
        {"$ref": "https://example.local/skat-ai/training_dataset.schema.json"},
        {"type": "null"}
      ]
    },
    "partition_audit": {
      "oneOf": [
        {
          "$ref": "https://example.local/skat-ai/dataset_partition_audit.schema.json"
        },
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {"status": {"const": "complete"}}
          }
        }
      },
      "then": {
        "properties": {
          "training_dataset_input": {
            "$ref": "https://example.local/skat-ai/training_dataset.schema.json"
          },
          "partition_audit": {
            "$ref": "https://example.local/skat-ai/dataset_partition_audit.schema.json"
          }
        }
      },
      "else": {
        "properties": {
          "training_dataset_input": {"type": "null"},
          "partition_audit": {"type": "null"}
        }
      }
    }
  ]
}
