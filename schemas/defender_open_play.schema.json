{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/defender_open_play.schema.json",
  "title": "skat-ai defender open-play input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "exposing_defender",
    "remaining_hands",
    "declarer_response"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "defender_open_play"},
    "exposing_defender": {"$ref": "#/$defs/player"},
    "remaining_hands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["me", "left", "right"],
      "properties": {
        "me": {"$ref": "#/$defs/remaining_hand"},
        "left": {"$ref": "#/$defs/remaining_hand"},
        "right": {"$ref": "#/$defs/remaining_hand"}
      }
    },
    "declarer_response": {"const": "accept_adjudication"}
  },
  "$defs": {
    "player": {
      "type": "string",
      "enum": ["me", "left", "right"]
    },
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "remaining_hand": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/card"}
    }
  }
}
