{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/open_card_throw.schema.json",
  "title": "skat-ai open card throw input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "throwing_player",
    "thrown_cards",
    "statement_classification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "open_card_throw"},
    "throwing_player": {
      "type": "string",
      "enum": ["me", "left", "right"]
    },
    "thrown_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/card"}
    },
    "statement_classification": {
      "type": "string",
      "enum": [
        "none",
        "generic_concession",
        "attempted_level_limitation"
      ]
    }
  },
  "$defs": {
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    }
  }
}
