{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/open_card_throw_output.schema.json",
  "title": "skat-ai open card throw output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "rule_sections",
    "throwing_player",
    "throwing_party",
    "opposing_party",
    "joint_liability",
    "thrown_cards",
    "thrown_card_count",
    "card_reconciliation",
    "statement_classification",
    "decision_state_before_shortening",
    "rest_trick_assignment",
    "rest_tricks_recipient",
    "remaining_trick_count",
    "observed_trick_counts",
    "rule_assigned_trick_counts",
    "final_trick_counts",
    "observed_points",
    "rule_assigned_points",
    "final_points",
    "adjudicated_winner",
    "winner_basis",
    "schneider_rule_level_applied",
    "schwarz_rule_level_applied",
    "theoretical_schwarz_status",
    "theoretical_schwarz_assessment",
    "continued_play_supported"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "open_card_throw"},
    "rule_sections": {
      "type": "array",
      "prefixItems": [{"const": "4.4.6"}],
      "minItems": 1,
      "maxItems": 1
    },
    "throwing_player": {"$ref": "#/$defs/player"},
    "throwing_party": {"$ref": "#/$defs/party"},
    "opposing_party": {"$ref": "#/$defs/party"},
    "joint_liability": {"type": "boolean"},
    "thrown_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/card"}
    },
    "thrown_card_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "card_reconciliation": {
      "type": "string",
      "enum": ["confirmed", "not_verifiable"]
    },
    "statement_classification": {
      "type": "string",
      "enum": ["none", "generic_concession", "attempted_level_limitation"]
    },
    "decision_state_before_shortening": {"$ref": "#/$defs/decision_state"},
    "rest_trick_assignment": {"$ref": "#/$defs/rest_trick_assignment"},
    "rest_tricks_recipient": {"$ref": "#/$defs/party"},
    "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "observed_trick_counts": {"$ref": "#/$defs/party_counts"},
    "rule_assigned_trick_counts": {"$ref": "#/$defs/party_counts"},
    "final_trick_counts": {"$ref": "#/$defs/party_counts"},
    "observed_points": {"$ref": "#/$defs/party_counts"},
    "rule_assigned_points": {"$ref": "#/$defs/party_counts"},
    "final_points": {"$ref": "#/$defs/party_counts"},
    "adjudicated_winner": {"$ref": "#/$defs/party"},
    "winner_basis": {
      "type": "string",
      "enum": [
        "open_card_throw_rule_state",
        "preexisting_game_decision",
        "failed_mandatory_level",
        "uncovered_overbid_requirement",
        "theoretically_excluded_required_schwarz"
      ]
    },
    "schneider_rule_level_applied": {"type": "boolean"},
    "schwarz_rule_level_applied": {"type": "boolean"},
    "theoretical_schwarz_status": {
      "type": "string",
      "enum": ["not_excluded", "excluded"]
    },
    "theoretical_schwarz_assessment": {
      "$ref": "https://example.local/skat-ai/theoretical_level_assessment.schema.json"
    },
    "continued_play_supported": {"const": false}
  },
  "$defs": {
    "player": {"type": "string", "enum": ["me", "left", "right"]},
    "party": {"type": "string", "enum": ["declarer", "defenders"]},
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "decision_state": {
      "type": "string",
      "enum": ["undecided", "declarer_already_won", "defenders_already_won"]
    },
    "party_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declarer", "defenders"],
      "properties": {
        "declarer": {"type": "integer", "minimum": 0, "maximum": 120},
        "defenders": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "rest_trick_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recipient",
        "remaining_trick_count",
        "assigned_card_count",
        "assigned_card_points"
      ],
      "properties": {
        "source": {"const": "open_card_throw"},
        "recipient": {"$ref": "#/$defs/party"},
        "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "assigned_card_count": {"type": "integer", "minimum": 3, "maximum": 30},
        "assigned_card_points": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "settlement_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_end_kind",
        "outcome_source",
        "winner_basis",
        "decision_state_before_game_end",
        "rest_tricks_recipient",
        "schneider_level_source",
        "schwarz_level_source",
        "theoretical_schwarz_status",
        "declared_mandatory_play_level",
        "mandatory_play_level",
        "mandatory_level_source",
        "mandatory_level_covered",
        "achieved_schneider_applied",
        "achieved_schwarz_applied",
        "open_throw_schneider_applied",
        "open_throw_schwarz_applied",
        "overbid_required_level",
        "overbid_requirement_covered",
        "overbid_required_value_applied"
      ],
      "properties": {
        "game_end_kind": {"const": "open_card_throw"},
        "outcome_source": {
          "type": "string",
          "enum": ["rule_adjudication", "preexisting_game_decision"]
        },
        "winner_basis": {"$ref": "#/$defs/winner_basis"},
        "decision_state_before_game_end": {"$ref": "#/$defs/decision_state"},
        "rest_tricks_recipient": {"$ref": "#/$defs/party"},
        "schneider_level_source": {
          "type": "string",
          "enum": ["open_card_throw_final_point_state", "not_applicable"]
        },
        "schwarz_level_source": {
          "type": "string",
          "enum": ["open_card_throw_rule_state", "not_applicable"]
        },
        "theoretical_schwarz_status": {
          "type": "string",
          "enum": ["not_excluded", "excluded"]
        },
        "declared_mandatory_play_level": {"$ref": "#/$defs/nullable_level"},
        "mandatory_play_level": {"$ref": "#/$defs/nullable_level"},
        "mandatory_level_source": {
          "type": ["string", "null"],
          "enum": [
            "declared_announcement",
            "overbid_requirement",
            "declared_announcement_and_overbid_requirement",
            null
          ]
        },
        "mandatory_level_covered": {"type": "boolean"},
        "achieved_schneider_applied": {"const": false},
        "achieved_schwarz_applied": {"const": false},
        "open_throw_schneider_applied": {"type": "boolean"},
        "open_throw_schwarz_applied": {"type": "boolean"},
        "overbid_required_level": {"$ref": "#/$defs/nullable_level"},
        "overbid_requirement_covered": {"type": "boolean"},
        "overbid_required_value_applied": {"type": "boolean"}
      }
    },
    "winner_basis": {
      "type": "string",
      "enum": [
        "open_card_throw_rule_state",
        "preexisting_game_decision",
        "failed_mandatory_level",
        "uncovered_overbid_requirement",
        "theoretically_excluded_required_schwarz"
      ]
    },
    "nullable_level": {
      "type": ["string", "null"],
      "enum": ["schneider", "schwarz", null]
    }
  }
}
