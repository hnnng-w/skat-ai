{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/historical_declarer_card_exposure_continuation_event_output.schema.json",
  "title": "skat-ai historical declarer-card-exposure continuation summary version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_index",
    "kind",
    "rule_sections",
    "after_play_count",
    "after_completed_trick_count",
    "event_during_incomplete_trick",
    "next_player_id",
    "declarer_player_id",
    "exposure_form",
    "defender_responses",
    "continuing_defender_player_ids",
    "accepting_defender_player_ids",
    "unanimous_acceptance",
    "continuation_required",
    "public_declarer_cards",
    "public_declarer_card_count",
    "card_reconciliation",
    "cards_remain_in_declarer_hand",
    "hand_physically_open",
    "visibility_scope",
    "claimed_play_level",
    "claimed_play_level_status",
    "first_affected_decision_index",
    "actual_plays_after_event",
    "exact_proof_applied",
    "game_end_applied",
    "settlement_applied",
    "final_game_end_reason",
    "final_outcome_source"
  ],
  "properties": {
    "event_index": {"const": 1},
    "kind": {"const": "declarer_card_exposure_continuation"},
    "rule_sections": {"const": ["4.4.4"]},
    "after_play_count": {"type": "integer", "minimum": 0, "maximum": 29},
    "after_completed_trick_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "event_during_incomplete_trick": {"type": "boolean"},
    "next_player_id": {"$ref": "#/$defs/stable_identifier"},
    "declarer_player_id": {"$ref": "#/$defs/stable_identifier"},
    "exposure_form": {"enum": ["laid_open", "shown_to_defender"]},
    "shown_to_defender_player_id": {"$ref": "#/$defs/stable_identifier"},
    "defender_responses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/response"}
    },
    "continuing_defender_player_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_identifier"}
    },
    "accepting_defender_player_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_identifier"}
    },
    "unanimous_acceptance": {"const": false},
    "continuation_required": {"const": true},
    "public_declarer_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/card"}
    },
    "public_declarer_card_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "card_reconciliation": {"const": "confirmed"},
    "cards_remain_in_declarer_hand": {"const": true},
    "hand_physically_open": {"const": true},
    "visibility_scope": {"const": "all_players"},
    "claimed_play_level": {"enum": ["simple", "schneider", "schwarz"]},
    "claimed_play_level_status": {"const": "continuation_required_no_immediate_settlement_effect"},
    "first_affected_decision_index": {"type": "integer", "minimum": 1, "maximum": 30},
    "actual_plays_after_event": {"type": "integer", "minimum": 0, "maximum": 30},
    "exact_proof_applied": {"const": false},
    "game_end_applied": {"const": false},
    "settlement_applied": {"const": false},
    "final_game_end_reason": {
      "enum": [
        "normal_completion",
        "declarer_concession",
        "defender_concession",
        "declarer_card_exposure",
        "defender_open_play",
        "open_card_throw",
        "party_wide_all_remaining_tricks_claim"
      ]
    },
    "final_outcome_source": {
      "enum": ["actual_continued_play", "subsequent_terminal_shortening"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"exposure_form": {"const": "shown_to_defender"}}},
      "then": {"required": ["shown_to_defender_player_id"]},
      "else": {"not": {"required": ["shown_to_defender_player_id"]}}
    }
  ],
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$"
    },
    "card": {"type": "string", "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"},
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defender_player_id", "response", "form"],
      "properties": {
        "defender_player_id": {"$ref": "#/$defs/stable_identifier"},
        "response": {"enum": ["accept", "continue"]},
        "form": {"enum": ["explicit", "unambiguous_conduct"]}
      }
    }
  }
}
