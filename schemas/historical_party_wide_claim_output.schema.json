{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/historical_party_wide_claim_output.schema.json",
  "title": "skat-ai historical party-wide Claim output version 1",
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!me$|left$|right$)(?:[\\s\\S]*\\S)?$"
    },
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    },
    "proof_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_party",
        "assigned_trick_count",
        "assigned_card_count",
        "assigned_card_points"
      ],
      "properties": {
        "recipient_party": {"enum": ["declarer", "defenders"]},
        "assigned_trick_count": {"type": "integer", "minimum": 1, "maximum": 5},
        "assigned_card_count": {"type": "integer", "minimum": 3, "maximum": 15},
        "assigned_card_points": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "game_result_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recipient",
        "remaining_trick_count",
        "assigned_card_count",
        "assigned_card_points"
      ],
      "properties": {
        "source": {"const": "party_wide_claim_proof_assignment"},
        "recipient": {"enum": ["declarer", "defenders"]},
        "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 5},
        "assigned_card_count": {"type": "integer", "minimum": 3, "maximum": 15},
        "assigned_card_points": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "proof_move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "card",
        "completed_trick_winner_player_id",
        "completed_trick_winner_party"
      ],
      "properties": {
        "player_id": {"$ref": "#/$defs/stable_identifier"},
        "card": {"$ref": "#/$defs/card"},
        "completed_trick_winner_player_id": {
          "oneOf": [
            {"$ref": "#/$defs/stable_identifier"},
            {"type": "null"}
          ]
        },
        "completed_trick_winner_party": {
          "type": ["string", "null"],
          "enum": ["declarer", "defenders", null]
        }
      }
    },
    "exact_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_version",
        "execution_method",
        "status",
        "proof_complete",
        "claim_satisfied",
        "evaluated_state_count",
        "memoized_state_count",
        "terminal_state_count",
        "counterexample_found",
        "assignment",
        "representative_line",
        "representative_line_scope"
      ],
      "properties": {
        "executor_version": {"const": 1},
        "execution_method": {
          "const": "party_wide_all_remaining_tricks_exact_and_or_v1"
        },
        "status": {"const": "valid"},
        "proof_complete": {"const": true},
        "claim_satisfied": {"const": true},
        "evaluated_state_count": {"type": "integer", "minimum": 1},
        "memoized_state_count": {"type": "integer", "minimum": 1},
        "terminal_state_count": {"type": "integer", "minimum": 1},
        "counterexample_found": {"const": false},
        "assignment": {"$ref": "#/$defs/proof_assignment"},
        "representative_line": {
          "type": "array",
          "items": {"$ref": "#/$defs/proof_move"},
          "minItems": 1,
          "maxItems": 15
        },
        "representative_line_scope": {
          "const": "diagnostic_decisive_branch_only"
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudication_result_version",
        "adjudication_facts_version",
        "status",
        "reason",
        "decision_state_before_claim",
        "outcome_source",
        "winner_basis",
        "adjudicated_winner",
        "final_declarer_points",
        "final_defender_points",
        "final_declarer_tricks",
        "final_defender_tricks",
        "remaining_points_recipient",
        "remaining_points_assigned",
        "achieved_schneider_status",
        "achieved_schwarz_status",
        "achieved_schneider_applied",
        "achieved_schwarz_applied",
        "overbid_required_level",
        "overbid_required_value_applied"
      ],
      "properties": {
        "adjudication_result_version": {"const": 1},
        "adjudication_facts_version": {"const": 1},
        "status": {"const": "adjudicated"},
        "reason": {"const": "valid_proof"},
        "decision_state_before_claim": {
          "enum": ["undecided", "declarer_already_won", "defenders_already_won"]
        },
        "outcome_source": {
          "enum": [
            "preexisting_game_decision",
            "exact_party_wide_claim_adjudication"
          ]
        },
        "winner_basis": {
          "enum": ["preexisting_game_decision", "completed_claim_assignment"]
        },
        "adjudicated_winner": {"enum": ["declarer", "defenders"]},
        "final_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "final_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "final_declarer_tricks": {"type": "integer", "minimum": 0, "maximum": 10},
        "final_defender_tricks": {"type": "integer", "minimum": 0, "maximum": 10},
        "remaining_points_recipient": {"enum": ["declarer", "defenders"]},
        "remaining_points_assigned": {"type": "integer", "minimum": 0, "maximum": 120},
        "achieved_schneider_status": {
          "enum": [
            "declarer_made_schneider",
            "defenders_made_schneider",
            "none",
            "not_applicable"
          ]
        },
        "achieved_schwarz_status": {
          "enum": [
            "declarer_made_schwarz",
            "defenders_made_schwarz",
            "none",
            "not_applicable"
          ]
        },
        "achieved_schneider_applied": {"type": "boolean"},
        "achieved_schwarz_applied": {"type": "boolean"},
        "overbid_required_level": {
          "type": ["string", "null"],
          "enum": ["schneider", "schwarz", null]
        },
        "overbid_required_value_applied": {"type": "boolean"}
      }
    },
    "point_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_trick_declarer_points",
        "completed_trick_defender_points",
        "skat_points",
        "observed_declarer_points",
        "observed_defender_points",
        "unresolved_current_trick_points",
        "unresolved_remaining_hand_points",
        "total_unresolved_points",
        "assigned_declarer_points",
        "assigned_defender_points",
        "final_declarer_points",
        "final_defender_points",
        "total_card_points"
      ],
      "properties": {
        "completed_trick_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "completed_trick_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "skat_points": {"type": "integer", "minimum": 0, "maximum": 22},
        "observed_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "observed_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "unresolved_current_trick_points": {"type": "integer", "minimum": 0, "maximum": 22},
        "unresolved_remaining_hand_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "total_unresolved_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "assigned_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "assigned_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "final_declarer_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "final_defender_points": {"type": "integer", "minimum": 0, "maximum": 120},
        "total_card_points": {"const": 120}
      }
    },
    "game_end_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "normative_matrix_case_id",
        "claimant_player_id",
        "claiming_party",
        "declarer_player_id",
        "defender_player_ids",
        "event_after_play_count",
        "event_after_completed_trick_count",
        "event_during_incomplete_trick",
        "remaining_trick_count",
        "proof_policy",
        "proof_quantifiers",
        "proof_maximum_unresolved_tricks",
        "exact_proof",
        "adjudication",
        "settlement_applied"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "party_wide_all_remaining_tricks_claim"},
        "normative_matrix_case_id": {
          "const": "claim_boundary.decision.party_wide_all_remaining_tricks_claim"
        },
        "claimant_player_id": {"$ref": "#/$defs/stable_identifier"},
        "claiming_party": {"enum": ["declarer", "defenders"]},
        "declarer_player_id": {"$ref": "#/$defs/stable_identifier"},
        "defender_player_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stable_identifier"},
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "event_after_play_count": {"type": "integer", "minimum": 15, "maximum": 29},
        "event_after_completed_trick_count": {"type": "integer", "minimum": 5, "maximum": 9},
        "event_during_incomplete_trick": {"type": "boolean"},
        "remaining_trick_count": {"type": "integer", "minimum": 1, "maximum": 5},
        "proof_policy": {"const": "party_wide_all_remaining_tricks_claim_v1"},
        "proof_quantifiers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor", "quantifier"],
              "properties": {
                "actor": {"const": "claiming_party"},
                "quantifier": {"const": "existential"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor", "quantifier"],
              "properties": {
                "actor": {"const": "opposing_party"},
                "quantifier": {"const": "universal"}
              }
            }
          ],
          "items": false
        },
        "proof_maximum_unresolved_tricks": {"const": 5},
        "exact_proof": {"$ref": "#/$defs/exact_proof"},
        "adjudication": {"$ref": "#/$defs/adjudication"},
        "settlement_applied": {"const": true}
      }
    }
  }
}
