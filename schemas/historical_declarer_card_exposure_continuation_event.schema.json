{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skat-ai/historical_declarer_card_exposure_continuation_event.schema.json",
  "title": "skat-ai historical declarer-card-exposure continuation event version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "after_play_count",
    "exposure",
    "claimed_play_level",
    "defender_responses",
    "public_declarer_cards"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "declarer_card_exposure_continuation"},
    "after_play_count": {"type": "integer", "minimum": 0, "maximum": 29},
    "exposure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["form"],
          "properties": {"form": {"const": "laid_open"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["form", "shown_to_defender_player_id"],
          "properties": {
            "form": {"const": "shown_to_defender"},
            "shown_to_defender_player_id": {"$ref": "#/$defs/stable_identifier"}
          }
        }
      ]
    },
    "claimed_play_level": {"enum": ["simple", "schneider", "schwarz"]},
    "defender_responses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defender_player_id", "response", "form"],
        "properties": {
          "defender_player_id": {"$ref": "#/$defs/stable_identifier"},
          "response": {"enum": ["accept", "continue"]},
          "form": {"enum": ["explicit", "unambiguous_conduct"]}
        }
      },
      "contains": {
        "type": "object",
        "required": ["response"],
        "properties": {"response": {"const": "continue"}}
      },
      "minContains": 1
    },
    "public_declarer_cards": {
      "type": "array",
      "items": {"$ref": "#/$defs/card"},
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    }
  },
  "$defs": {
    "stable_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$",
      "not": {"enum": ["me", "left", "right"]}
    },
    "card": {
      "type": "string",
      "pattern": "^[CSHD](A|10|K|Q|J|9|8|7)$"
    }
  }
}
